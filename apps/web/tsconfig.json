{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/lib/packageConfig": ["./src/cliente/package-config.ts"],
      "@/*": ["./heredado/*"],
      "~/*": ["./src/*"]
    },
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["app", "src", "heredado", "middleware.ts", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
