# Aisla las dependencias por paquete: un paquete solo puede importar lo que declara.
# Es lo que hace cumplir la regla de dependencia entre capas (04-ARQUITECTURA §2)
# a nivel de gestor de paquetes, no solo por lint.
node-linker=isolated
strict-peer-dependencies=false
auto-install-peers=true
engine-strict=true

# Todo el almacen de paquetes vive en D:, no en C:.
# Miguel cuida el espacio del disco del sistema (7-sep-2026).
# Debe estar en la MISMA unidad que el monorepo para que los enlaces duros
# funcionen; si no, pnpm copia en vez de enlazar y ocupa multiplicado.
store-dir=D:/.pnpm-store
