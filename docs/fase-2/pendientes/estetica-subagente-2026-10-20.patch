+ * Con el mensaje de AGENDAR y no con el de ver: quien recibe esto intentaba poner una cita,
+ * no mirar una agenda.
+ */
+export async function exigirColumnaPropia(
+  ctx: ContextoComando<Transaccion>,
+  profesionalIds: readonly string[],
+): Promise<void> {
+  if (!SOLO_LO_SUYO.includes(ctx.ambito.rol)) return;
+  // Sin pedir ninguna: la suya, o `NINGUNA` si el empleo no está ligado a una profesional.
+  const suya = (await profesionalVisible(ctx, null)) ?? NINGUNA;
+  if (profesionalIds.some((id) => id !== suya)) {
+    throw new ErrorDominio('PUENTE_SIN_PERMISO', 'Sólo agendas en tu propia columna.');
+  }
+}
