@@ -0,0 +1,73 @@
+'use client';
+
+import { useEffect, useState } from 'react';
+
+import { ErrorApi, invocarComando } from '~/cliente/api';
+
+/**
+ * EL ANTICIPO DE UNA CITA, leído para decidir sobre él (F-412).
+ *
+ * Marcar que la clienta no llegó resuelve su anticipo —el salón se lo queda o se lo devuelve—
+ * y eso se decide con el monto y el medio a la vista, no con una casilla a ciegas. El puente
+ * no sirve `anticipos_cita`; lo sirve `anticipo.de_la_cita`, sólo a la recepción.
+ *
+ * Cuatro estados, y los cuatro se dicen: leyéndose, sin anticipo (la mayoría de las citas),
+ * con él, o sin poder leerlo. Un fallo NO se confunde con «no dejó anticipo»: callar que no se
+ * pudo saber dejaba marcar creyendo que no había dinero de por medio.
+ */
+
+/** Lo que `anticipo.de_la_cita` contesta cuando la cita tiene un anticipo en pie. */
+export interface AnticipoDeLaCita {
+  readonly anticipoId: string;
+  /** Centavos, en texto: es dinero y viaja como el resto de los comandos. */
+  readonly montoCentavos: string;
+  readonly metodo: string;
+}
+
+export type LecturaDelAnticipo =
+  | { readonly estado: 'leyendo' }
+  | { readonly estado: 'sin' }
+  | { readonly estado: 'con'; readonly anticipo: AnticipoDeLaCita }
+  | { readonly estado: 'fallo'; readonly mensaje: string };
+
+export function useAnticipoDeLaCita(citaId: string): {
+  readonly lectura: LecturaDelAnticipo;
+  readonly volverALeer: () => void;
+} {
+  const [lectura, setLectura] = useState<LecturaDelAnticipo>({ estado: 'leyendo' });
+  const [intento, setIntento] = useState(0);
+
+  useEffect(() => {
+    const control = new AbortController();
+    invocarComando<{ readonly anticipo: AnticipoDeLaCita | null }>(
+      '/api/anticipos/de-la-cita',
+      { citaId },
+      { signal: control.signal },
+    )
+      .then((salida) => {
+        if (control.signal.aborted) return;
+        setLectura(
+          salida.anticipo === null
+            ? { estado: 'sin' }
+            : { estado: 'con', anticipo: salida.anticipo },
+        );
+      })
+      .catch((error: unknown) => {
+        if (control.signal.aborted) return;
+        setLectura({
+          estado: 'fallo',
+          mensaje: error instanceof ErrorApi ? error.message : 'No se pudo leer el anticipo.',
+        });
+      });
+    return () => {
+      control.abort();
+    };
+  }, [citaId, intento]);
+
+  function volverALeer(): void {
+    setLectura({ estado: 'leyendo' });
+    setIntento((previo) => previo + 1);
+  }
+
+  return { lectura, volverALeer };
+}
