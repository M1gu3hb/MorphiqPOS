+  type BloqueConHora,
+  type ResultadoDelNoLlego,
+} from './sin-llegar.ts';
+
+/**
+ * F-412 · «A los 15 minutos de retraso el sistema lo propone; la recepción confirma o pone
+ * "va en camino"». Y «el automatismo puro es un error: la clienta que llega 20 minutos tarde es
+ * normal en México».
+ */
+
+const DIA = '2026-09-16';
+/** El formato de importe de la prueba: el de `<Dinero>` lo pone la pantalla, aquí no se carga. */
+const pesos = (centavos: number): string => `$${(centavos / 100).toFixed(2)}`;
+/** Las 18:00 del miércoles, en la hora local del navegador que corre la prueba. */
+const A_LAS = (hora: string) => new Date(`${DIA}T${hora}:00`).getTime();
+
+const bloque = (cambios: Partial<BloqueConHora> = {}): BloqueConHora => ({
+  id: 'servicio-1',
+  citaId: 'cita-1',
+  inicio: '18:00',
+  estado: 'sin_confirmar',
+  profesional: 'Karla',
+  clienta: 'Ximena Lara',
+  servicio: 'Peinado de evento',
+  ...cambios,
+});
+
+describe('cuánto se tarda una clienta', () => {
+  it('son los minutos desde su hora, y negativos mientras todavía falta', () => {
+    expect(minutosDeRetraso(DIA, '18:00', A_LAS('18:23'))).toBe(23);
+    expect(minutosDeRetraso(DIA, '18:00', A_LAS('18:00'))).toBe(0);
+    expect(minutosDeRetraso(DIA, '18:00', A_LAS('17:30'))).toBe(-30);
+  });
+
+  it('los segundos de un minuto no cuentan: a las 18:14:59 todavía son 14 minutos', () => {
+    expect(minutosDeRetraso(DIA, '18:00', A_LAS('18:14') + 59_000)).toBe(14);
+    expect(minutosDeRetraso(DIA, '18:00', A_LAS('18:15') + 59_000)).toBe(15);
+    // Y por eso la pregunta no sale un segundo antes de los quince minutos.
+    expect(citasSinLlegar([bloque()], DIA, A_LAS('18:14') + 59_000)).toEqual([]);
+  });
+
+  it('un día futuro nunca está tarde, y uno pasado siempre', () => {
+    expect(minutosDeRetraso('2026-09-17', '10:00', A_LAS('23:59'))).toBeLessThan(0);
+    expect(minutosDeRetraso('2026-09-15', '10:00', A_LAS('00:01'))).toBeGreaterThan(
+      MINUTOS_DE_TOLERANCIA,
+    );
+  });
+
+  it('una hora que no se entiende no pregunta nada: nunca «tarde» por un tecleo', () => {
+    expect(minutosDeRetraso(DIA, 'x', A_LAS('18:23'))).toBe(Number.NEGATIVE_INFINITY);
+  });
+});
+
+describe('las citas que el sistema pregunta', () => {
+  it('A LOS 15 MINUTOS, no antes: la que lleva 14 todavía puede venir en camino', () => {
+    expect(citasSinLlegar([bloque()], DIA, A_LAS('18:14'))).toEqual([]);
+    const preguntadas = citasSinLlegar([bloque()], DIA, A_LAS('18:15'));
+    expect(preguntadas).toHaveLength(1);
+    expect(preguntadas[0]?.minutosDeRetraso).toBe(MINUTOS_DE_TOLERANCIA);
+  });
+
+  it('dice quién, cuándo y con quién: lo que se necesita para decidir con la puerta a la vista', () => {
+    const [cita] = citasSinLlegar([bloque()], DIA, A_LAS('18:20'));
+    expect(cita).toEqual({
+      citaId: 'cita-1',
+      hora: '18:00',
+      clienta: 'Ximena Lara',
+      profesional: 'Karla',
+      servicios: 'Peinado de evento',
+      nombresDeServicios: ['Peinado de evento'],
+      minutosDeRetraso: 20,
+    });
