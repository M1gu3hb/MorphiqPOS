+import { obtenerDb } from '@morphiqpos/data';
+
+import { ambitoDe, clave, exigirOk } from '../pruebas/negocio-real.ts';
+import { comando } from '../produccion.ts';
+import { agendarCita } from './agenda.ts';
+import { abrirProducto } from './cabina.ts';
+import type { SalonConCabina } from './cabina.integracion.siembra.ts';
+import { cerrarServicio } from './ciclo.ts';
+import { capturarFormula } from './formula.ts';
+
+/** Las lecturas y las órdenes de UN salón sembrado. */
+export function conSalon(salon: SalonConCabina) {
+  const ambito = () => ambitoDe(salon.negocio, salon.sucursalId, null);
+
+  /** Lo que dicen las existencias del tinte en un almacén. */
+  async function existenciaDelTinte(almacenId: string): Promise<number> {
+    const fila = await obtenerDb()
+      .selectFrom('existencias')
+      .select('cantidad')
+      .where('almacen_id', '=', almacenId)
+      .where('insumo_id', '=', salon.tinteInsumoId)
+      .executeTakeFirst();
+    return Number(fila?.cantidad ?? 0);
+  }
+
+  /** El testigo: lo que hay del OTRO insumo en cada almacén, que ninguna operación del tinte toca. */
+  async function elTestigo(): Promise<{ anaquel: number; cabina: number }> {
+    const filas = await obtenerDb()
+      .selectFrom('existencias')
+      .select(['almacen_id', 'cantidad'])
+      .where('insumo_id', '=', salon.shampooInsumoId)
+      .execute();
+    const de = (almacenId: string): number =>
+      Number(filas.find((f) => f.almacen_id === almacenId)?.cantidad ?? Number.NaN);
+    return { anaquel: de(salon.almacenDeVenta), cabina: de(salon.almacenDeCabina) };
+  }
+
+  /** La fórmula guardada de una cita, tal como quedó en el expediente. */
+  async function formulaGuardada(citaId: string) {
+    const fila = await obtenerDb()
+      .selectFrom('formulas_aplicadas as f')
+      .innerJoin('cita_servicios as cs', 'cs.id', 'f.cita_servicio_id')
+      .select('f.formula')
+      .where('cs.cita_id', '=', citaId)
+      .orderBy('f.created_at', 'desc')
+      .executeTakeFirstOrThrow();
+    return fila.formula as {
+      componentes: { nombre: string; cantidad: number; unidad: string; productoId?: string }[];
+    };
+  }
+
+  const movimientosDelTinte = () =>
+    obtenerDb()
+      .selectFrom('movimientos_stock')
+      .select([
+        'tipo',
+        'almacen_id',
+        'cantidad',
+        'unidad',
+        'costo_unitario_centavos',
+        'motivo',
+        'nota',
+      ])
+      .where('insumo_id', '=', salon.tinteInsumoId)
+      .orderBy('created_at')
+      .orderBy('tipo')
+      .execute();
+
+  /** Una cita nueva con un servicio abierto, y el id de ESE servicio. */
+  async function citaConServicio(
+    inicio: string,
+  ): Promise<{ citaId: string; servicioDeLaCita: string }> {
+    const { citaId } = exigirOk(
+      await comando(agendarCita, {
+        entrada: {
+          clienteId: salon.clientaId,
+          inicio,
+          servicios: [{ servicioId: salon.servicioId, profesionalId: salon.profesionalId }],
+        },
+        ambito: ambito(),
+        idempotencyKey: clave(),
+      }),
+      'agenda.agendar_cita',
+    );
+    const fila = await obtenerDb()
+      .selectFrom('cita_servicios')
+      .select('id')
+      .where('cita_id', '=', citaId)
+      .executeTakeFirstOrThrow();
+    return { citaId, servicioDeLaCita: fila.id };
+  }
+
+  const abrir = (piezas = 1) =>
+    comando(abrirProducto, {
+      entrada: { productoId: salon.tinteId, piezas },
+      ambito: ambito(),
+      idempotencyKey: clave(),
+    });
+
+  /** Guarda una fórmula con UN componente ligado al tinte. Devuelve lo que contestó el comando. */
+  const capturar = (citaId: string, gramos: number, unidad = 'g') =>
+    comando(capturarFormula, {
+      entrada: {
+        citaId,
+        mezclado: gramos + 30,
+        usado: gramos + 25,
+        minutos: 35,
+        componentes: [
+          { nombre: '6.0', cantidad: gramos, unidad, productoId: salon.tinteId },
+          { nombre: 'ox 20 vol', cantidad: 90, unidad: 'ml' },
+        ],
+      },
+      ambito: ambito(),
+      idempotencyKey: clave(),
+    });
+
+  const cerrar = (citaServicioId: string) =>
+    comando(cerrarServicio, {
+      entrada: { citaServicioId, consumos: [], formula: {} },
+      ambito: ambito(),
+      idempotencyKey: clave(),
+    });
+
+  return {
+    ambito,
+    existenciaDelTinte,
+    elTestigo,
+    formulaGuardada,
+    movimientosDelTinte,
+    citaConServicio,
+    abrir,
+    capturar,
+    cerrar,
+  };
+}
