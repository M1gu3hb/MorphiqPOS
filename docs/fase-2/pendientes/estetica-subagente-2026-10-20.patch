+++ b/apps/web/src/estetica-salon/walk-in.ts
@@ -0,0 +1,132 @@
+/**
+ * LA WALK-IN EN DOS TOQUES (F-413), lo puro de `WalkIn`: qué se ofrece, con quién, y la
+ * secuencia de comandos que la convierte en una clienta sentada.
+ *
+ * ── Una cita que nació hace treinta segundos ─────────────────────────────────────
+ * «La walk-in es una cita, no un tipo de venta distinto» (`01-FUNCIONES §3.17`): se agenda
+ * AHORA con la hora del servidor (`agenda.walk_in`), ocupa el hueco, y EMPIEZA —la clienta ya
+ * está sentada—. Son dos comandos (agendar, iniciar) y no uno a propósito: cada uno es el de
+ * siempre, con sus guardas, y si el segundo falla la cita queda agendada y se dice, en vez de
+ * desaparecer.
+ *
+ * ── Con clienta si se puede, sin clienta si hay prisa ────────────────────────────
+ * El nombre es opcional: «pedir nombre, teléfono y correo a alguien que quiere un corte de
+ * $250 es perder la venta». Si lo da, se da de alta (nombre, y teléfono si lo tiene) y la cita
+ * es suya; si no, se atiende y se cobra sin ficha.
+ */
+
+export interface ServicioDeLaWalkIn {
+  readonly id: string;
+  readonly nombre: string;
+}
+
+/** Quién da qué: una fila por pareja, como la sirve `servicios.asignaciones`. */
+export interface AsignacionDeLaWalkIn {
+  readonly servicioId: string;
+  readonly profesionalId: string;
+}
+
+export interface PersonaDeLaWalkIn {
+  readonly id: string;
+  readonly nombre: string;
+}
+
+/**
+ * Los servicios que se ofrecen: los que ALGUIEN da. Con `fija` —la estilista, que sólo se ve a
+ * sí misma— los que ELLA da: ofrecerle uno que no da sería una cita que el servidor rechaza.
+ */
+export function serviciosParaLaWalkIn(
+  servicios: readonly ServicioDeLaWalkIn[],
+  asignaciones: readonly AsignacionDeLaWalkIn[],
+  fija: string | null,
+): readonly ServicioDeLaWalkIn[] {
+  return servicios.filter((servicio) =>
+    asignaciones.some(
+      (a) => a.servicioId === servicio.id && (fija === null || a.profesionalId === fija),
+    ),
+  );
+}
+
+/** Quiénes dan el servicio, en el orden del equipo; con `fija`, sólo ella si lo da. */
+export function quienesDanElServicio(
+  servicioId: string,
+  asignaciones: readonly AsignacionDeLaWalkIn[],
+  equipo: readonly PersonaDeLaWalkIn[],
+  fija: string | null,
+): readonly PersonaDeLaWalkIn[] {
+  const dan = new Set(
+    asignaciones.filter((a) => a.servicioId === servicioId).map((a) => a.profesionalId),
+  );
+  return equipo.filter((persona) => dan.has(persona.id) && (fija === null || persona.id === fija));
+}
+
+/**
+ * Quién la atiende: la ÚNICA que puede, sin preguntar; si hay varias, la que se eligió o —si no
+ * se eligió— aquella por la que se abrió la hoja («Mi día» de Karla), mientras siga siendo una
+ * de las opciones. Sin opciones o sin elección, nadie: el botón queda apagado.
+ */
+export function quienLaAtiende(
+  opciones: readonly PersonaDeLaWalkIn[],
+  elegida: string | null,
+  sugerida: string | null,
+): string | null {
+  const unica = opciones.length === 1 ? opciones[0] : undefined;
+  if (unica !== undefined) return unica.id;
+  const valida = (id: string | null): string | null =>
+    id !== null && opciones.some((o) => o.id === id) ? id : null;
+  return valida(elegida) ?? valida(sugerida);
+}
+
+/** Lo que `WalkIn` necesita de `invocarComando`: se inyecta para probar la secuencia sin red. */
+export type InvocarComando = <T>(ruta: string, entrada: unknown) => Promise<T>;
+
+/**
+ * Da de alta a la clienta que dijo su nombre. `null` si no lo dijo. El teléfono, si no lo
+ * tiene a mano, no se inventa: la ficha nace sin él. Una ficha con su teléfono repetido es la
+ * que ya existía (`cliente.alta` la devuelve), y es lo que se quiere en el mostrador.
+ */
+export async function darDeAltaALaClienta(
+  invocar: InvocarComando,
+  nombre: string,
+  telefono: string,
+): Promise<string | null> {
+  const limpio = nombre.trim();
+  if (limpio === '') return null;
+  const alta = await invocar<{ readonly clienteId: string }>('/api/clientes', {
+    nombre: limpio,
+    telefono: telefono.trim() === '' ? null : telefono.trim(),
+  });
+  return alta.clienteId;
+}
+
+export interface WalkInTomada {
+  readonly citaId: string;
+  /** Falso si la cita quedó agendada pero no se pudo empezar: se dice y se deja a mano. */
+  readonly empezada: boolean;
+  readonly falloAlEmpezar: string | null;
+}
+
+/** Agenda la walk-in ahora y la empieza. Si agendar falla, nada quedó; si empezar falla, se dice. */
+export async function tomarLaWalkIn(
+  invocar: InvocarComando,
+  datos: {
+    readonly clientaId: string | null;
+    readonly servicioId: string;
+    readonly profesionalId: string;
+  },
+): Promise<WalkInTomada> {
+  const cita = await invocar<{ readonly citaId: string }>('/api/citas/walk-in', {
+    ...(datos.clientaId === null ? {} : { clienteId: datos.clientaId }),
+    servicios: [{ servicioId: datos.servicioId, profesionalId: datos.profesionalId }],
+  });
+  try {
+    await invocar(`/api/citas/${encodeURIComponent(cita.citaId)}/iniciar`, {});
+    return { citaId: cita.citaId, empezada: true, falloAlEmpezar: null };
+  } catch (fallo: unknown) {
+    return {
+      citaId: cita.citaId,
+      empezada: false,
+      falloAlEmpezar: fallo instanceof Error ? fallo.message : 'No se pudo empezar.',
+    };
+  }
+}
