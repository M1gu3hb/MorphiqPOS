+describe('agenda.walk_in · quién la toma', () => {
+  it('la recepción, quien dirige Y LA ESTILISTA; nadie más', () => {
+    expect([...agendarWalkIn.roles].toSorted()).toEqual(
+      ['administrador', 'cajero', 'dueno', 'gerente', 'mesero'].toSorted(),
+    );
+  });
+});
