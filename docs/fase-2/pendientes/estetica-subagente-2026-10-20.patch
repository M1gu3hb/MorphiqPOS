+          }
+        >
+          {fallo}
+        </Aviso>
+      ) : kardex === null ? (
+        <EsqueletoDeLista filas={3} />
+      ) : (
+        <>
+          <Tabla
+            etiqueta="Kardex de la cabina"
+            columnas={columnas}
+            // El más reciente arriba: es el que se viene a buscar.
+            filas={[...kardex.renglones].reverse()}
+            claveDe={(r) => r.movimientoId}
+            alto="max-h-[50vh]"
+            vacio={
+              <Vacio
+                icono={<History />}
+                titulo="Todavía no entra nada a la cabina."
+                explicacion="Cada pieza que se abre y lo que gasta cada fórmula aparece aquí."
+              />
+            }
+          />
+          {kardex.hayMas ? (
+            <p className="text-xs text-texto-sutil">
+              Se ven los {LIMITE} más recientes; hay movimientos más viejos en esos días.
+            </p>
+          ) : null}
+        </>
+      )}
+    </Superficie>
+  );
+}
