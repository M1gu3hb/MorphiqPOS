+import { describe, expect, it } from 'vitest';
+
+import { alergiaDeclarada, declaraAlergia } from './alergia-del-expediente.ts';
+
+/**
+ * F-153 · La bandera de alergia se levanta con una alergia, no con cualquier texto.
+ *
+ * La agenda la pinta en la esquina del bloque y la cita en curso la dice con su palabra junto
+ * al nombre: las dos leen del mismo criterio.
+ */
+describe('qué cuenta como alergia declarada', () => {
+  it('una sustancia es una alergia, con o sin mayúsculas y espacios de más', () => {
+    expect(declaraAlergia('PPD (tintes oscuros)')).toBe(true);
+    expect(declaraAlergia('  amoniaco ')).toBe(true);
+    expect(declaraAlergia('Látex y PPD')).toBe(true);
+  });
+
+  it('sin contestar no levanta la bandera: el vacío tampoco es una alergia', () => {
+    expect(declaraAlergia('')).toBe(false);
+    expect(declaraAlergia('   ')).toBe(false);
+    expect(declaraAlergia(null)).toBe(false);
+    expect(declaraAlergia(undefined)).toBe(false);
+  });
+
+  it('«ninguna conocida» es una RESPUESTA: se preguntó y no hay', () => {
+    for (const respuesta of [
+      'ninguna',
+      'Ninguna conocida',
+      'NO',
+      'no tiene',
+      'Sin alergias',
+      '-',
+      '  ninguna conocida  ',
+    ]) {
+      expect(declaraAlergia(respuesta), respuesta).toBe(false);
+    }
+  });
+
+  it('una alergia que EMPIEZA como una respuesta negativa sigue siendo alergia', () => {
+    expect(declaraAlergia('ninguna conocida, salvo el PPD')).toBe(true);
+    expect(declaraAlergia('no tolera el amoniaco')).toBe(true);
+  });
+});
+
+describe('la alergia que se enseña', () => {
+  it('es el texto que se escribió, sin los espacios de los lados', () => {
+    expect(alergiaDeclarada('  PPD (tintes oscuros) ')).toBe('PPD (tintes oscuros)');
+  });
+
+  it('es `null` cuando no hay nada que decir', () => {
+    expect(alergiaDeclarada('ninguna conocida')).toBeNull();
+    expect(alergiaDeclarada('')).toBeNull();
+    expect(alergiaDeclarada(null)).toBeNull();
+    expect(alergiaDeclarada(undefined)).toBeNull();
+  });
+});
