@@ -0,0 +1,90 @@
+import 'server-only';
+
+import type { Transaccion } from '@morphiqpos/data';
+
+import type { ContextoComando } from '../definicion.ts';
+import { aEscala, deEscala } from './existencias-de-cabina.ts';
+
+/**
+ * EL CONSUMO DE CABINA QUE SALE DE LA FÓRMULA (F-154, `03-INVENTARIO §5.3`).
+ *
+ * ── «Una captura, tres efectos» ──────────────────────────────────────────────────────
+ * La fórmula que la estilista guarda con los guantes puestos es el expediente de la
+ * clienta Y lo que se gastó de cabina Y el costo del servicio. `expediente.capturar_formula`
+ * guardaba el primero y `agenda.cerrar_servicio` sólo descontaba lo que le DECÍAN —la
+ * pantalla nunca decía nada—: el tubo de tinte que se fue en la cabeza de Mariana seguía en
+ * la cabina, y «Cerrar servicio» prometía en su pie «consume el material de cabina».
+ *
+ * ── Lo que cuenta ────────────────────────────────────────────────────────────────────
+ *   · la ÚLTIMA fórmula de ESE servicio manda: guardar otra para corregir la anterior no
+ *     gasta el material dos veces;
+ *   · sólo los componentes LIGADOS a un producto de cabina (`productoId`): «6.0 · 70 g»
+ *     escrito a mano es expediente, no inventario;
+ *   · lo de un mismo producto se suma, a cuatro decimales exactos (enteros escalados, nunca
+ *     coma flotante).
+ *
+ * El sobrante de la mezcla (lo que se tiró) sigue siendo un dato de la fórmula y no tiene
+ * movimiento propio: el costo de lo que se pesó se imputa entero al servicio.
+ */
+
+export interface ConsumoDeFormula {
+  readonly productoId: string;
+  readonly cantidadBase: string;
+}
+
+/** Lo que se lee de un componente de fórmula congelado, sin confiar en su forma. */
+function ligadoDe(valor: unknown): { productoId: string; cantidad: number } | null {
+  if (typeof valor !== 'object' || valor === null) return null;
+  const { productoId, cantidad } = valor as Record<string, unknown>;
+  if (typeof productoId !== 'string' || productoId === '') return null;
+  if (typeof cantidad !== 'number' || !Number.isFinite(cantidad)) return null;
+  return { productoId, cantidad };
+}
+
+/**
+ * El jsonb congelado, venga como objeto —Postgres— o como el texto que se escribió —el
+ * doble de las pruebas—. Un componente a medio escribir no tira el cierre del servicio: lo
+ * que no tiene la forma se queda fuera, y sin materiales ligados no hay nada que descontar.
+ */
+function componentesDe(formula: unknown): readonly unknown[] {
+  // Un texto que no es JSON LANZA: una fórmula corrupta es un dato roto y se dice, no se
+  // cierra el servicio sin descontar como si nada (R12).
+  const objeto: unknown = typeof formula === 'string' ? JSON.parse(formula) : formula;
+  if (typeof objeto !== 'object' || objeto === null) return [];
+  const { componentes } = objeto as Record<string, unknown>;
+  return Array.isArray(componentes) ? (componentes as readonly unknown[]) : [];
+}
+
+/** Los consumos de cabina de un servicio, derivados de la última fórmula guardada para él. */
+export async function consumosDeLaFormula(
+  ctx: ContextoComando<Transaccion>,
+  citaServicioId: string,
+): Promise<readonly ConsumoDeFormula[]> {
+  const ultima = await ctx.paso('leer_formula_del_servicio', () =>
+    ctx.tx
+      .selectFrom('formulas_aplicadas')
+      .select('formula')
+      .where('organizacion_id', '=', ctx.ambito.organizacionId)
+      .where('cita_servicio_id', '=', citaServicioId)
+      .orderBy('aplicada_en', 'desc')
+      .orderBy('created_at', 'desc')
+      .limit(1)
+      .executeTakeFirst(),
+  );
+  if (ultima === undefined) return [];
+
+  const porProducto = new Map<string, bigint>();
+  for (const componente of componentesDe(ultima.formula)) {
+    const ligado = ligadoDe(componente);
+    if (ligado === null) continue;
+    // Pasar por texto con cuatro decimales evita que 62.5 o 0.1 + 0.2 entren como flotante.
+    const escalada = aEscala(ligado.cantidad.toFixed(4));
+    // Cero, negativo, o tan chico que a cuatro decimales es cero: no gasta nada.
+    if (escalada <= 0n) continue;
+    porProducto.set(ligado.productoId, (porProducto.get(ligado.productoId) ?? 0n) + escalada);
+  }
+  return [...porProducto].map(([productoId, cantidad]) => ({
+    productoId,
+    cantidadBase: deEscala(cantidad),
+  }));
+}
