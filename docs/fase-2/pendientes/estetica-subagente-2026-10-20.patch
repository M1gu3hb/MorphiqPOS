+
+describe('lo que se le dice a la recepción ANTES de decidir sobre el anticipo', () => {
+  const efectivo = { montoCentavos: '28500', metodo: 'efectivo' };
+  const tarjeta = { montoCentavos: '28500', metodo: 'tarjeta' };
+
+  it('retenerlo: el salón se queda con el monto, y es ingreso por cancelación, no venta', () => {
