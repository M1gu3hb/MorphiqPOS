+/**
+ * Los componentes ligados a un producto, COMPROBADOS: cada `productoId` tiene que ser de este
+ * negocio y de un producto que se usa en cabina, y su unidad es la de la cabina.
+ *
+ * Se dice qué falla en vez de guardar una liga que después no descuenta nada: una fórmula
+ * con un «bote» que ninguna cabina tiene se descubriría al cerrar el servicio, con la
+ * clienta esperando en la caja. La unidad la pone el producto —la que se cuenta en cabina—
+ * y no la que llegó: gramos contra mililitros descontaría una cantidad que no es.
+ */
+async function ligarALaCabina(
+  ctx: ContextoComando<Transaccion>,
+  componentes: readonly ComponenteDeEntrada[],
+): Promise<readonly ComponenteDeEntrada[]> {
+  const ids = [
+    ...new Set(componentes.flatMap((c) => (c.productoId === undefined ? [] : [c.productoId]))),
+  ];
+  if (ids.length === 0) return componentes;
+
+  const productos = await ctx.paso('leer_materiales_de_cabina', () =>
+    ctx.tx
+      .selectFrom('productos')
+      .select(['id', 'nombre', 'destino', 'unidad_cabina'])
+      .where('organizacion_id', '=', ctx.ambito.organizacionId)
+      .where('id', 'in', ids)
+      .execute(),
+  );
+  const porId = new Map(productos.map((p) => [p.id, p]));
+  return componentes.map((c) => {
+    if (c.productoId === undefined) return c;
+    const producto = porId.get(c.productoId);
+    if (producto === undefined) {
+      throw new ErrorDominio(
+        'PRODUCTO_NO_ENCONTRADO',
+        `«${c.nombre}» está ligado a un producto que no existe en este negocio.`,
+        { productoId: c.productoId },
+      );
+    }
+    if (producto.destino === 'venta' || producto.unidad_cabina == null) {
+      throw new ErrorDominio(
+        'CATALOGO_INVALIDO',
+        `«${producto.nombre}» no se usa en cabina: no se puede ligar a la fórmula. ` +
+          'Márcalo «Sólo se usa» o «Las dos cosas» en Productos.',
+        { productoId: producto.id },
+      );
+    }
+    return { ...c, unidad: producto.unidad_cabina };
+  });
