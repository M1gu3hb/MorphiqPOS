diff --git a/apps/web/src/estetica-salon/SinLlegar.tsx b/apps/web/src/estetica-salon/SinLlegar.tsx
new file mode 100644
index 0000000..e832282
--- /dev/null
+++ b/apps/web/src/estetica-salon/SinLlegar.tsx
@@ -0,0 +1,300 @@
+'use client';
+
+import { Button } from '@morphiqpos/ui/primitivas/button';
+import { Checkbox } from '@morphiqpos/ui/primitivas/checkbox';
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@morphiqpos/ui/primitivas/dialog';
+import { Input } from '@morphiqpos/ui/primitivas/input';
+import { Label } from '@morphiqpos/ui/primitivas/label';
+import { Aviso, Dinero, Esqueleto, Superficie, Vacio, dineroEnTexto } from '@morphiqpos/ui/sistema';
+import { HandCoins } from 'lucide-react';
+
+import { ListaDeEspera } from './ListaDeEspera.tsx';
+import { useConfirmarLaFalta, useSinLlegar } from './sin-llegar-estado.ts';
+import {
+  huecoQueDejo,
+  loQuePasaraConElAnticipo,
+  loQueQuedoDelNoLlego,
+  medioDelAnticipo,
+  retrasoEnPalabras,
+  type BloqueConHora,
+  type CitaSinLlegar,
+  type FaltaMarcada,
+  type QuienDecideEnLaAgenda,
+  type ResultadoDelNoLlego,
+} from './sin-llegar.ts';
+
+/**
+ * LAS CITAS SIN LLEGAR, que el sistema propone y la recepción decide (F-412, F-409; D.1 de la
+ * 2.4). Lo puro vive en `sin-llegar.ts` y el estado en `sin-llegar-estado.ts`; aquí se pinta.
+ *
+ * ── Arriba de la agenda, no en el cajón de pendientes ────────────────────────────
+ * «Marcar que no llegó» es una acción del pico (`04-INTERFAZ §4.6`, condición 7: uno o dos
+ * toques) y tras «Pendientes» eran tres. Sólo aparece cuando hay a quién preguntar.
+ *
+ * ── Qué decide quien toca ────────────────────────────────────────────────────────
+ * «No llegó» abre una confirmación que LEE el anticipo y dice qué pasará con él: por omisión
+ * el salón se lo queda —la penalización—, devolverlo es la excepción. «Va en camino» aplaza la
+ * pregunta quince minutos. Después se cuenta qué quedó hecho y A QUIÉN LE SIRVE el hueco.
+ */
+
+export interface SinLlegarProps {
+  /** Los bloques como los pinta la agenda. */
+  readonly bloques: readonly BloqueConHora[];
+  /** El día que se mira (`AAAA-MM-DD`) y el reloj del mostrador: nulos hasta el montaje. */
+  readonly dia: string | null;
+  readonly ahoraMs: number | null;
+  readonly decide: QuienDecideEnLaAgenda;
+  /** Se marcó una falta: la agenda tiene que volver a leerse. */
+  readonly alMarcar: () => void;
+}
+
+export function SinLlegar({ bloques, dia, ahoraMs, decide, alMarcar }: SinLlegarProps) {
+  const estado = useSinLlegar(bloques, dia, ahoraMs, decide, alMarcar);
+  const { sinLlegar, contada, eligiendo } = estado;
+
+  return (
+    <>
+      {sinLlegar.length === 0 ? null : (
+        <Aviso
+          tono="atencion"
+          anuncio="ninguno" // el retraso cambia cada minuto: como región viva, se leería cada vez
+          titulo={
+            sinLlegar.length === 1
+              ? 'Una cita ya pasó de su hora y la clienta no llega.'
+              : `${String(sinLlegar.length)} citas ya pasaron de su hora y la clienta no llega.`
+          }
+        >
+          <ul
+            aria-label="Citas sin llegar"
+            className="mt-(--espacio-2) flex flex-col gap-(--espacio-3)"
+          >
+            {sinLlegar.map((cita) => (
+              <FilaSinLlegar
+                key={cita.citaId}
+                cita={cita}
+                alAplazar={estado.aplazar}
+                alDecidir={estado.setEligiendo}
+              />
+            ))}
+          </ul>
+        </Aviso>
+      )}
+      {contada === null ? null : (
+        <FaltaContada
+          falta={contada}
+          veLaEspera={decide.veLaEspera}
+          alCerrar={estado.olvidarLoContado}
+        />
+      )}
+      {eligiendo === null ? null : (
+        <ConfirmarLaFalta
+          key={eligiendo.citaId}
+          cita={eligiendo}
+          alCerrar={() => {
+            estado.setEligiendo(null);
+          }}
+          alMarcada={(resultado) => {
+            estado.yaSeMarco(eligiendo, resultado);
+          }}
+        />
+      )}
+    </>
+  );
+}
+
+function FilaSinLlegar({
+  cita,
+  alAplazar,
+  alDecidir,
+}: {
+  readonly cita: CitaSinLlegar;
+  readonly alAplazar: (citaId: string) => void;
+  readonly alDecidir: (cita: CitaSinLlegar) => void;
+}) {
+  // El nombre accesible lleva a QUIÉN: en una lista de varias, «No llegó» solo no dice de quién.
+  const quien = cita.clienta ?? 'la clienta';
+  return (
+    <li className="flex flex-wrap items-center justify-between gap-(--espacio-2)">
+      <span className="flex min-w-0 flex-col">
+        <span className="font-medium">{cita.clienta ?? 'Sin registrar'}</span>
+        <span className="text-sm text-texto-sutil">
+          {cita.hora} con {cita.profesional} · {cita.servicios} · lleva{' '}
+          {retrasoEnPalabras(cita.minutosDeRetraso)}
+        </span>
+      </span>
+      <span className="flex gap-(--espacio-2)">
+        <Button
+          variant="outline"
+          onClick={() => {
+            alAplazar(cita.citaId);
+          }}
+        >
+          Va en camino<span className="sr-only">: {quien}</span>
+        </Button>
+        <Button
+          onClick={() => {
+            alDecidir(cita);
+          }}
+        >
+          No llegó<span className="sr-only">: {quien}</span>
+        </Button>
+      </span>
+    </li>
+  );
+}
+
+/** La confirmación: se monta con la cita y se desmonta al cerrar, así que arranca limpia. */
+function ConfirmarLaFalta({
+  cita,
+  alCerrar,
+  alMarcada,
+}: {
+  readonly cita: CitaSinLlegar;
+  readonly alCerrar: () => void;
+  readonly alMarcada: (resultado: ResultadoDelNoLlego) => void;
+}) {
+  const { lectura, enviando, fallo, devolver, nota, ...acciones } = useConfirmarLaFalta(
+    cita,
+    alMarcada,
+  );
+  const quien = cita.clienta ?? 'la clienta';
+
+  return (
+    <Dialog
+      open
+      onOpenChange={(abierto) => {
+        if (!abierto && !enviando) alCerrar();
+      }}
+    >
+      <DialogContent showCloseButton={false}>
+        <DialogHeader>
+          <DialogTitle>¿Marcar que {quien} no llegó?</DialogTitle>
+          <DialogDescription>
+            Su cita de las {cita.hora} con {cita.profesional} lleva{' '}
+            {retrasoEnPalabras(cita.minutosDeRetraso)} de retraso. Al marcarla, el hueco queda libre
+            para otra clienta y la falta se anota en su historial, firmada con tu nombre.
+          </DialogDescription>
+        </DialogHeader>
+        <div className="flex flex-col gap-(--espacio-4)">
+          {lectura.estado === 'leyendo' ? (
+            <div role="status" aria-busy="true" aria-label="Leyendo si dejó anticipo">
+              <Esqueleto className="h-[calc(var(--altura-control)*1.3)] w-full rounded-lg" />
+            </div>
+          ) : lectura.estado === 'fallo' ? (
+            <Aviso
+              tono="atencion"
+              titulo="No se pudo leer si dejó anticipo."
+              accion={
+                <Button size="sm" variant="outline" onClick={acciones.volverALeer}>
+                  Volver a intentar
+                </Button>
+              }
+            >
+              {lectura.mensaje} Si lo dejó, el salón se queda con él: es lo normal.
+            </Aviso>
+          ) : lectura.estado === 'sin' ? (
+            <Vacio
+              tamano="compacto"
+              icono={<HandCoins />}
+              titulo="No dejó anticipo."
+              explicacion="No hay dinero suyo que resolver: sólo se libera el hueco y se anota la falta."
+              className="py-(--espacio-2)"
+            />
+          ) : (
+            <div className="flex items-start gap-(--espacio-3)">
+              <Checkbox
+                id="devolver-el-anticipo"
+                className="mt-0.5 size-5"
+                checked={devolver}
+                disabled={enviando}
+                onCheckedChange={(marcado) => {
+                  acciones.setDevolver(marcado === true);
+                }}
+              />
+              <Label htmlFor="devolver-el-anticipo" className="flex flex-col items-start gap-1">
+                <span>
+                  Devolverle su anticipo de{' '}
+                  <Dinero centavos={Number(lectura.anticipo.montoCentavos)} tamano="sm" />
+                </span>
+                <span className="text-xs font-normal text-texto-sutil">
+                  Lo dejó {medioDelAnticipo(lectura.anticipo.metodo)}.{' '}
+                  {loQuePasaraConElAnticipo(lectura.anticipo, devolver, dineroEnTexto)}
+                </span>
+              </Label>
+            </div>
+          )}
+          <div className="flex flex-col gap-(--espacio-1)">
+            <Label htmlFor="nota-de-la-falta">Nota (opcional)</Label>
+            <Input
+              id="nota-de-la-falta"
+              maxLength={200}
+              value={nota}
+              disabled={enviando}
+              placeholder="Avisó que no llegaba, no contestó…"
+              onChange={(evento) => {
+                acciones.setNota(evento.target.value);
+              }}
+            />
+          </div>
+          {fallo === null ? null : (
+            <Aviso tono="peligro" titulo={fallo}>
+              La cita sigue como estaba.
+            </Aviso>
+          )}
+        </div>
+        <DialogFooter>
+          <Button variant="outline" disabled={enviando} onClick={alCerrar}>
+            Todavía no
+          </Button>
+          <Button disabled={enviando || lectura.estado === 'leyendo'} onClick={acciones.marcar}>
+            {enviando ? 'Marcando…' : 'Marcar que no llegó'}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
+
+/** Lo que quedó hecho, y a quién le sirve el hueco que se liberó. Se cierra con «Entendido». */
+function FaltaContada({
+  falta,
+  veLaEspera,
+  alCerrar,
+}: {
+  readonly falta: FaltaMarcada;
+  readonly veLaEspera: boolean;
+  readonly alCerrar: () => void;
+}) {
+  const { titulo, lineas } = loQueQuedoDelNoLlego(falta.cita, falta.resultado, dineroEnTexto);
+  return (
+    <div className="flex flex-col gap-(--espacio-3)">
+      <Aviso
+        tono="info"
+        titulo={titulo}
+        accion={
+          <Button size="sm" variant="outline" onClick={alCerrar}>
+            Entendido
+          </Button>
+        }
+      >
+        <ul className="mt-(--espacio-1) list-disc pl-(--espacio-4) text-sm">
+          {lineas.map((linea) => (
+            <li key={linea}>{linea}</li>
+          ))}
+        </ul>
+      </Aviso>
+      {veLaEspera ? (
+        <Superficie relleno={4} radio="md">
+          <ListaDeEspera hueco={huecoQueDejo(falta.cita, falta.dia)} />
+        </Superficie>
+      ) : null}
+    </div>
+  );
+}
