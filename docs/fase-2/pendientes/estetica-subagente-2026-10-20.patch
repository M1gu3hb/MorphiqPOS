+
+    const sirven = esperasParaElHueco([paola, conOtra, otroServicio, cualquiera, yaPaso], hueco);
+    expect(sirven.map((e) => e.esperaId)).toEqual(['paola', 'cualquiera']);
+  });
+});
+
+describe('el retraso en palabras de mostrador', () => {
+  it('minutos hasta la hora; a partir de ahí, horas y minutos', () => {
+    expect(retrasoEnPalabras(15)).toBe('15 min');
+    expect(retrasoEnPalabras(59)).toBe('59 min');
+    expect(retrasoEnPalabras(60)).toBe('1 h');
+    expect(retrasoEnPalabras(65)).toBe('1 h 5 min');
+    expect(retrasoEnPalabras(125)).toBe('2 h 5 min');
+  });
+});
+
+describe('lo que se le dice a la recepción cuando se marcó', () => {
+  const cita = { clienta: 'Ximena Lara', hora: '18:00', profesional: 'Karla' } as const;
+  const resultado = (cambios: Partial<ResultadoDelNoLlego> = {}): ResultadoDelNoLlego => ({
+    valorPerdidoCentavos: '95000',
+    anticipo: null,
+    faltasEnSeisMeses: 1,
+    ...cambios,
+  });
+
+  it('dice que no llegó y que el hueco quedó libre, con la hora y con quién', () => {
+    const { titulo } = loQueQuedoDelNoLlego(cita, resultado(), pesos);
+    expect(titulo).toBe('Ximena Lara no llegó. El hueco de las 18:00 con Karla quedó libre.');
+  });
+
+  it('un anticipo RETENIDO se dice como lo que es: ingreso por cancelación, no venta', () => {
+    const { lineas } = loQueQuedoDelNoLlego(
+      cita,
+      resultado({ anticipo: { estado: 'retenido', montoCentavos: '28500', metodo: 'efectivo' } }),
+      pesos,
+    );
+    expect(lineas.join(' ')).toContain('se quedó con su anticipo de $285.00');
+    expect(lineas.join(' ')).toContain('ingreso por cancelación, no venta de servicio');
+  });
+
+  it('uno DEVUELTO dice por dónde regresó: del cajón si fue efectivo', () => {
+    const efectivo = loQueQuedoDelNoLlego(
+      cita,
+      resultado({ anticipo: { estado: 'devuelto', montoCentavos: '28500', metodo: 'efectivo' } }),
+      pesos,
+    );
+    expect(efectivo.lineas.join(' ')).toContain(
+      'Se le devolvió su anticipo de $285.00: salió del cajón',
