@@ -0,0 +1,245 @@
+/**
+ * LAS CITAS SIN LLEGAR, que el sistema PROPONE y la recepción decide (F-412; D.1 de la 2.4).
+ * Lo puro de `SinLlegar`, sin React y con su prueba (`sin-llegar.test.ts`).
+ *
+ * ── Por qué se propone y no se deduce ─────────────────────────────────────────────
+ * «La clienta que llega 20 minutos tarde es normal en México» (`01-FUNCIONES §3.16`): el
+ * automatismo puro convertiría un atasco de tráfico en un antecedente, y la primera vez que le
+ * pasara a una clienta buena el salón apagaría la función. Lo que hay que hacer es PREGUNTAR a
+ * los quince minutos, y que alguien con nombre —queda firmado— confirme o diga «va en camino».
+ *
+ * ── Qué cuenta como «sin llegar» ──────────────────────────────────────────────────
+ * Una cita que NI SIQUIERA EMPEZÓ —agendada o confirmada— y cuya hora pasó hace al menos la
+ * tolerancia. Una que ya está en curso, terminada, cobrada, cancelada o marcada no se propone:
+ * no hay nada que preguntar. El retraso se mide contra el reloj del navegador, que es el del
+ * mostrador: es el que ve quien decide, con la clienta o sin ella en la puerta.
+ */
+
+import type { HuecoLiberado } from './lista-de-espera.ts';
+
+/** Los minutos de retraso a los que el sistema pregunta. Antes de eso, no. */
+export const MINUTOS_DE_TOLERANCIA = 15;
+
+/** Cuánto se aplaza la pregunta cuando se dice «va en camino». */
+export const MINUTOS_DE_ESPERA_EXTRA = 15;
+
+/** Lo único que se necesita de un bloque de la agenda para saber si la clienta está tarde. */
+export interface BloqueConHora {
+  readonly id: string;
+  readonly citaId: string | null;
+  /** `HH:MM`, hora LOCAL del salón: así se pinta el bloque. */
+  readonly inicio: string;
+  readonly estado: string;
+  readonly profesional: string;
+  readonly clienta: string | null;
+  readonly servicio: string | null;
+}
+
+/** Una cita que ya pasó de su hora y sigue sin llegar. */
+export interface CitaSinLlegar {
+  readonly citaId: string;
+  readonly hora: string;
+  readonly clienta: string | null;
+  readonly profesional: string;
+  /** Los servicios de la cita, juntos: «Tinte, Corte». */
+  readonly servicios: string;
+  /** Los mismos, uno por uno: lo que hace falta para ofrecer el hueco a quien espera. */
+  readonly nombresDeServicios: readonly string[];
+  readonly minutosDeRetraso: number;
+}
+
+/**
+ * Qué puede hacer en la agenda quien entra. Lo decide el SERVIDOR con los roles de cada comando
+ * (`servidor/inicio-del-salon.ts`) y viaja como dato: el navegador no adivina qué se le permite,
+ * y no pide —ni ofrece— lo que sabe que va a recibir un 403.
+ */
+export interface QuienDecideEnLaAgenda {
+  /** Puede marcar que una clienta no llegó: es de la recepción, no de la estilista. */
+  readonly marcaLaFalta: boolean;
+  /** Puede leer la lista de espera: también es sólo de la recepción. */
+  readonly veLaEspera: boolean;
+  /** Puede dar de alta a la clienta que dé su nombre en una walk-in: la estilista no. */
+  readonly daDeAltaClientas: boolean;
+}
+
+/** Los estados en que la cita todavía espera a la clienta. Lo que se pinta como agendada. */
+const ESPERANDO: ReadonlySet<string> = new Set(['agendada', 'sin_confirmar']);
+
+/**
+ * Cuántos minutos pasaron de la hora de la cita; negativo si todavía falta.
+ *
+ * `dia` es `AAAA-MM-DD` y `hora` es `HH:MM`, los dos LOCALES, como los pinta la agenda: se
+ * arma la fecha sin `Z`, en la zona del navegador, que es la del mostrador.
+ */
+export function minutosDeRetraso(dia: string, hora: string, ahoraMs: number): number {
+  const inicio = new Date(`${dia}T${hora}:00`).getTime();
+  if (Number.isNaN(inicio)) return Number.NEGATIVE_INFINITY;
+  return Math.floor((ahoraMs - inicio) / 60_000);
+}
+
+/**
+ * Las citas del día que hay que preguntar, de la más tarde a la menos tarde.
+ *
+ * `aplazadas` es lo que se dijo «va en camino»: cada una vuelve a preguntarse hasta el
+ * instante que dice. Una cita con VARIOS servicios son varios bloques y es UNA sola pregunta.
+ */
+export function citasSinLlegar(
+  bloques: readonly BloqueConHora[],
+  dia: string,
+  ahoraMs: number,
+  aplazadas: ReadonlyMap<string, number> = new Map(),
+): readonly CitaSinLlegar[] {
+  const porCita = new Map<string, BloqueConHora[]>();
+  for (const bloque of bloques) {
+    if (bloque.citaId === null || !ESPERANDO.has(bloque.estado)) continue;
+    porCita.set(bloque.citaId, [...(porCita.get(bloque.citaId) ?? []), bloque]);
+  }
+
+  const salida: CitaSinLlegar[] = [];
+  for (const [citaId, bloquesDeLaCita] of porCita) {
+    // En el orden en que se dan: «Corte, Lavado», no como los devolvió el servidor.
+    const suyos = bloquesDeLaCita.toSorted((a, b) => a.inicio.localeCompare(b.inicio));
+    const primero = suyos[0];
+    if (primero === undefined) continue;
+    const retraso = minutosDeRetraso(dia, primero.inicio, ahoraMs);
+    if (retraso < MINUTOS_DE_TOLERANCIA) continue;
+    if (ahoraMs < (aplazadas.get(citaId) ?? Number.NEGATIVE_INFINITY)) continue;
+    salida.push({
+      citaId,
+      hora: primero.inicio,
+      clienta: primero.clienta,
+      profesional: primero.profesional,
+      servicios: suyos.map((b) => b.servicio ?? 'Servicio').join(', '),
+      // Un servicio sin nombre no se ofrece a nadie por nombre: la espera de «cualquier
+      // servicio» sí lo recibe.
+      nombresDeServicios: suyos.map((b) => b.servicio).filter((s): s is string => s !== null),
+      minutosDeRetraso: retraso,
+    });
+  }
+  return salida.toSorted((a, b) => b.minutosDeRetraso - a.minutosDeRetraso);
+}
+
+/**
+ * El hueco que deja una cita que no llegó, en los términos de la lista de espera.
+ *
+ * Empieza a la hora de la cita —no a la de marcarla, que es después— porque la ventana de quien
+ * espera dice «el sábado por la tarde», y el hueco que se le ofrece es el que quedó libre.
+ */
+export function huecoQueDejo(cita: CitaSinLlegar, dia: string): HuecoLiberado {
+  return {
+    profesional: cita.profesional,
+    inicioMs: new Date(`${dia}T${cita.hora}:00`).getTime(),
+    servicios: cita.nombresDeServicios,
+  };
+}
+
+/** Hasta cuándo se aplaza la pregunta de una cita a la que se le dijo «va en camino». */
+export function aplazarHasta(ahoraMs: number): number {
+  return ahoraMs + MINUTOS_DE_ESPERA_EXTRA * 60_000;
+}
+
+/** El retraso en palabras de mostrador: «23 min», «1 h 5 min». */
+export function retrasoEnPalabras(minutos: number): string {
+  if (minutos < 60) return `${String(minutos)} min`;
+  const horas = Math.floor(minutos / 60);
+  const resto = minutos % 60;
+  return resto === 0 ? `${String(horas)} h` : `${String(horas)} h ${String(resto)} min`;
+}
+
+/** Lo que `agenda.marcar_no_llego` contesta, y de lo que sale lo que se le dice a la recepción. */
+export interface ResultadoDelNoLlego {
+  /** Lo que valía la cita, en centavos. */
+  readonly valorPerdidoCentavos: string;
+  /** `null` si la cita no tenía anticipo vivo. */
+  readonly anticipo: {
+    readonly estado: 'retenido' | 'devuelto';
+    readonly montoCentavos: string;
+    readonly metodo: string;
+  } | null;
+  /** Con ésta incluida. 0 si la cita no tenía clienta con ficha. */
+  readonly faltasEnSeisMeses: number;
+}
+
+/** Una falta que ya se marcó, con el día en que se marcó: la pantalla la cuenta mientras es ése. */
+export interface FaltaMarcada {
+  readonly dia: string;
+  readonly cita: CitaSinLlegar;
+  readonly resultado: ResultadoDelNoLlego;
+}
+
+/**
+ * El formateador del dinero lo pone quien llama —`dineroEnTexto` del sistema—: así hay un solo
+ * formato de importe en pantalla (el de `<Dinero>`), y este módulo se prueba sin cargar la
+ * biblioteca de componentes.
+ */
+export type FormatoDeDinero = (centavos: number) => string;
+
+/** Cómo se dice el medio con que se dio el anticipo. */
+export function medioDelAnticipo(metodo: string): string {
+  if (metodo === 'efectivo') return 'en efectivo';
+  if (metodo === 'tarjeta') return 'con tarjeta';
+  if (metodo === 'transferencia') return 'por transferencia';
+  return `por ${metodo}`;
+}
+
+/**
+ * LO QUE VA A PASAR CON EL ANTICIPO según lo que se decida, dicho ANTES de marcar.
+ *
+ * Retenerlo es lo normal —la penalización es quedarse con un anticipo ya cobrado—; devolverlo
+ * es la excepción, y si fue en efectivo SALE DEL CAJÓN, por lo que pide la caja abierta. Se
+ * dice con el monto: «$285.00 salen del cajón» se decide distinto que «el anticipo».
+ */
+export function loQuePasaraConElAnticipo(
+  anticipo: { readonly montoCentavos: string; readonly metodo: string },
+  devolver: boolean,
+  enPesos: FormatoDeDinero,
+): string {
+  const monto = enPesos(Number(anticipo.montoCentavos));
+  if (!devolver) {
+    return `El salón se queda con los ${monto}: es ingreso por cancelación, no venta de servicio.`;
+  }
+  return anticipo.metodo === 'efectivo'
+    ? `Se le devuelven los ${monto} y salen del cajón: la caja tiene que estar abierta.`
+    : `Se le devuelven los ${monto} por el mismo medio con que los dio, fuera del cajón.`;
+}
+
+/**
+ * LO QUE PASÓ CUANDO SE MARCÓ QUE NO LLEGÓ, en palabras de mostrador (F-412).
+ *
+ * Cuatro efectos —se marca, se libera el hueco, se valúa la pérdida y queda en el historial—
+ * y uno más cuando hay dinero de por medio: qué se hizo con el anticipo. Marcar sin decir
+ * cualquiera de ellos es «un checkbox inútil»: quien toca el botón tiene que poder leer qué
+ * quedó hecho, sobre todo si el dinero de una clienta cambió de dueño.
+ */
+export function loQueQuedoDelNoLlego(
+  cita: Pick<CitaSinLlegar, 'clienta' | 'hora' | 'profesional'>,
+  resultado: ResultadoDelNoLlego,
+  enPesos: FormatoDeDinero,
+): { readonly titulo: string; readonly lineas: readonly string[] } {
+  const quien = cita.clienta ?? 'La clienta';
+  const lineas: string[] = [
+    `Lo que valía la cita: ${enPesos(Number(resultado.valorPerdidoCentavos))}.`,
+  ];
+
+  const { anticipo } = resultado;
+  if (anticipo !== null) {
+    const monto = enPesos(Number(anticipo.montoCentavos));
+    lineas.push(
+      anticipo.estado === 'retenido'
+        ? `El salón se quedó con su anticipo de ${monto}: es ingreso por cancelación, no venta de servicio.`
+        : `Se le devolvió su anticipo de ${monto}${anticipo.metodo === 'efectivo' ? ': salió del cajón' : ' por el mismo medio con que lo dio'}.`,
+    );
+  }
+
+  const faltas = resultado.faltasEnSeisMeses;
+  if (faltas === 1) lineas.push('Es su primera falta en seis meses.');
+  else if (faltas === 2) lineas.push('Es su segunda falta en seis meses: enciende el aviso.');
+  else if (faltas >= 3) {
+    lineas.push(`Van ${String(faltas)} faltas en seis meses: la próxima vez se le pide anticipo.`);
+  }
+
+  return {
+    titulo: `${quien} no llegó. El hueco de las ${cita.hora} con ${cita.profesional} quedó libre.`,
+    lineas,
+  };
+}
