@@ -0,0 +1,185 @@
+import { randomUUID } from 'node:crypto';
+
+import { conTransaccion } from '@morphiqpos/data';
+
+import { sembrarNegocio, sembrarSucursal, type NegocioReal } from '../pruebas/negocio-real.ts';
+
+/**
+ * LO QUE LAS PRUEBAS DE INTEGRACIÓN DE LA CABINA COMPARTEN: un salón sembrado en Postgres con su
+ * anaquel, su cabina, un tinte que se vende Y se abre, y una profesional que da el servicio.
+ *
+ * No es una prueba: lo importan `cabina.integracion.test.ts` y `formula-ultima.integracion.test.ts`
+ * (cada una siembra SU salón, así que no se pisan). Las lecturas y las órdenes de un salón ya
+ * sembrado están en `cabina.integracion.ayuda.ts`.
+ */
+
+/** Lo que cuesta el tubo (por PIEZA) y lo que rinde al abrirse. */
+export const TUBO_CENTAVOS = 13_100n;
+export const RINDE_G = 100;
+export const EN_EL_ANAQUEL = 5;
+/** Lo que hay de OTRO insumo en el mismo anaquel y en la misma cabina: nada de esto se mueve. */
+export const SHAMPOO_EN_EL_ANAQUEL = 9;
+export const SHAMPOO_EN_LA_CABINA = 700;
+
+export interface SalonConCabina {
+  readonly negocio: NegocioReal;
+  readonly sucursalId: string;
+  readonly almacenDeVenta: string;
+  readonly almacenDeCabina: string;
+  readonly tinteId: string;
+  readonly tinteInsumoId: string;
+  /** Otro insumo con existencia en los DOS almacenes: el testigo de que no se toca lo que no es. */
+  readonly shampooInsumoId: string;
+  readonly servicioId: string;
+  readonly profesionalId: string;
+  readonly clientaId: string;
+}
+
+export async function sembrarSalonConCabina(nombre: string): Promise<SalonConCabina> {
+  const negocio = await sembrarNegocio({
+    nombre,
+    rol: 'gerente',
+    giro: 'estetica',
+    paquete: 'estetica',
+  });
+  const { sucursalId, almacenId: almacenDeVenta } = await sembrarSucursal(negocio, {
+    terminales: [],
+  });
+  const almacenDeCabina = randomUUID();
+  const tinteId = randomUUID();
+  const tinteInsumoId = randomUUID();
+  const shampooInsumoId = randomUUID();
+  const servicioId = randomUUID();
+  const profesionalId = randomUUID();
+  const clientaId = randomUUID();
+  const org = negocio.organizacionId;
+  await conTransaccion(async (tx) => {
+    await tx
+      .insertInto('almacenes')
+      .values({
+        id: almacenDeCabina,
+        organizacion_id: org,
+        sucursal_id: sucursalId,
+        nombre: 'Cabina',
+        principal: false,
+      })
+      .execute();
+    // El tubo de $131 que se vende en el anaquel Y se abre en cabina: 100 g por pieza.
+    await tx
+      .insertInto('productos')
+      .values({
+        id: tinteId,
+        organizacion_id: org,
+        nombre: 'Tinte permanente castaño 6.0',
+        precio_venta_centavos: 21_900n,
+        costo_unitario_centavos: TUBO_CENTAVOS,
+        estrategia_consumo: 'sku',
+        destino: 'ambos',
+        factor_apertura: String(RINDE_G),
+        unidad_cabina: 'g',
+      })
+      .execute();
+    await tx
+      .insertInto('insumos')
+      .values({
+        id: tinteInsumoId,
+        organizacion_id: org,
+        producto_id: tinteId,
+        nombre: 'Tinte permanente castaño 6.0',
+        unidad_base: 'pieza',
+        costo_unitario_centavos: TUBO_CENTAVOS,
+      })
+      .execute();
+    await tx
+      .insertInto('existencias')
+      .values({
+        organizacion_id: org,
+        almacen_id: almacenDeVenta,
+        insumo_id: tinteInsumoId,
+        cantidad: String(EN_EL_ANAQUEL),
+      })
+      .execute();
+    // El testigo: otro insumo en los MISMOS dos almacenes. Un `update` al que le falte el filtro del
+    // insumo mueve también el suyo, y una base con un solo insumo por almacén nunca lo notaría.
+    await tx
+      .insertInto('insumos')
+      .values({
+        id: shampooInsumoId,
+        organizacion_id: org,
+        nombre: 'Shampoo de anaquel',
+        unidad_base: 'pieza',
+        costo_unitario_centavos: 17_400n,
+      })
+      .execute();
+    await tx
+      .insertInto('existencias')
+      .values([
+        {
+          organizacion_id: org,
+          almacen_id: almacenDeVenta,
+          insumo_id: shampooInsumoId,
+          cantidad: String(SHAMPOO_EN_EL_ANAQUEL),
+        },
+        {
+          organizacion_id: org,
+          almacen_id: almacenDeCabina,
+          insumo_id: shampooInsumoId,
+          cantidad: String(SHAMPOO_EN_LA_CABINA),
+        },
+      ])
+      .execute();
+    await tx
+      .insertInto('productos')
+      .values({
+        id: servicioId,
+        organizacion_id: org,
+        nombre: 'Tinte de raíz',
+        precio_venta_centavos: 65_000n,
+        tipo_venta: 'servicio',
+        estrategia_consumo: 'ninguno',
+      })
+      .execute();
+    await tx
+      .insertInto('servicios')
+      .values({ producto_id: servicioId, organizacion_id: org, duracion_activa_1_min: 40 })
+      .execute();
+    await tx
+      .insertInto('profesionales')
+      .values({
+        id: profesionalId,
+        organizacion_id: org,
+        sucursal_id: sucursalId,
+        empleo_id: negocio.empleoId,
+        nombre_completo: 'Karla de Prueba',
+        nombre_corto: 'Karla',
+        tipo_relacion: 'empleado',
+        color_agenda: '#aa33cc',
+      })
+      .execute();
+    await tx
+      .insertInto('servicios_profesional')
+      .values({
+        organizacion_id: org,
+        servicio_id: servicioId,
+        profesional_id: profesionalId,
+        precio_centavos: 65_000n,
+      })
+      .execute();
+    await tx
+      .insertInto('clientes')
+      .values({ id: clientaId, organizacion_id: org, nombre: 'Mariana de Prueba' })
+      .execute();
+  });
+  return {
+    negocio,
+    sucursalId,
+    almacenDeVenta,
+    almacenDeCabina,
+    tinteId,
+    tinteInsumoId,
+    shampooInsumoId,
+    servicioId,
+    profesionalId,
+    clientaId,
+  };
+}
diff --git a/packages/app/src/salon/cabina.integracion.test.ts b/packages/app/src/salon/cabina.integracion.test.ts
