+/** Lo que hay de un producto del salón en cada lugar, como lo sirve `cabina.existencias`. */
+export interface ExistenciaEnLosDosLugares {
+  readonly productoId: string;
+  readonly insumoId: string;
+  /** En piezas, con los cuatro decimales de la base: `'22.0000'`. */
+  readonly enAnaquel: string;
+  /** En la unidad de cabina; nulo si el producto no se abre en cabina. */
+  readonly enCabina: string | null;
+  readonly unidadCabina: string | null;
+}
+
+/**
+ * CUÁNTO HAY EN EL ANAQUEL Y CUÁNTO EN LA CABINA, por separado (`cabina.existencias`).
+ *
+ * El puente suma todos los almacenes en una sola `existencia`: un tinte con 21 piezas en el
+ * anaquel y 30 g abiertos en cabina saldría como 51, que no es ni piezas ni gramos. Para exigir
+ * que abrir una pieza movió LOS DOS lugares, y que el servicio gastó de la cabina y no del
+ * anaquel, se lee aquí.
+ */
+export async function existenciaEnLosDosLugares(
+  page: Page,
+  producto: string,
+): Promise<ExistenciaEnLosDosLugares> {
+  const { existencias } = await ordenar<{
+    readonly existencias: readonly (ExistenciaEnLosDosLugares & { readonly nombre: string })[];
+  }>(page, '/api/inventario/cabina/existencias', {}, 'cabina.existencias');
+  const fila = existencias.find((e) => e.nombre === producto);
+  expect(fila, `cabina.existencias no trae «${producto}».`).toBeDefined();
+  return fila as ExistenciaEnLosDosLugares;
+}
+
+/** La ficha de cabina de un producto como la tiene el servidor: lo que la pantalla guardó. */
+export async function fichaDeCabinaDe(
+  page: Page,
+  producto: string,
+): Promise<{
+  readonly destino: string | null;
+  readonly rinde: number | null;
+  readonly unidad: string | null;
+}> {
+  const [fila] = await consultarPuente<{
+    readonly destino?: string | null;
+    readonly factor_apertura?: number | null;
+    readonly unidad_cabina?: string | null;
+  }>(page, 'ProductoTerminado', { filtro: { nombre: producto }, limite: 1 });
+  expect(fila, `El catálogo no trae «${producto}».`).toBeDefined();
+  return {
+    destino: fila?.destino ?? null,
+    rinde: fila?.factor_apertura ?? null,
+    unidad: fila?.unidad_cabina ?? null,
+  };
+}
+
+/** Un movimiento del kardex de un producto, como lo sirve el puente. */
+export interface MovimientoDelProducto {
+  readonly tipo: string;
+  /** Con signo: negativo es lo que salió. */
+  readonly cantidad: number;
+  readonly unidad: string;
+  /** EN PESOS por unidad: el puente convierte `costo_unitario_centavos`. */
+  readonly costoPorUnidad: number;
+  readonly referenciaTipo: string | null;
+  readonly referenciaId: string | null;
+}
+
+export async function movimientosDelProducto(
+  page: Page,
+  producto: string,
+): Promise<readonly MovimientoDelProducto[]> {
+  const movimientos = await consultarPuente<{
+    readonly ingrediente_nombre?: string | null;
+    readonly tipo_movimiento?: string | null;
+    readonly cantidad?: number | string | null;
+    readonly unidad_base?: string | null;
+    readonly costo_unitario_en_momento?: number | null;
+    readonly referencia_tipo?: string | null;
+    readonly referencia_id?: string | null;
+  }>(page, 'MovimientoInventario', { limite: 2000 });
+  return movimientos
+    .filter((m) => m.ingrediente_nombre === producto)
+    .map((m) => ({
+      tipo: m.tipo_movimiento ?? '',
+      cantidad: Number(m.cantidad ?? 0),
+      unidad: m.unidad_base ?? '',
+      costoPorUnidad: m.costo_unitario_en_momento ?? Number.NaN,
+      referenciaTipo: m.referencia_tipo ?? null,
+      referenciaId: m.referencia_id ?? null,
+    }));
+}
