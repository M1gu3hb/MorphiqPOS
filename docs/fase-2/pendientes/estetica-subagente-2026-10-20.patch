+import { esErrorDominio } from '@morphiqpos/contracts';
+import { describe, expect, it } from 'vitest';
+
+import {
+  contextoFalso,
+  crearBaseFalsa,
+  type TablasFalsas,
+} from '../restaurante/pruebas/base-falsa.ts';
+import { ambitoDe, ORG, SUCURSAL, TERMINAL } from '../restaurante/pruebas/sala.ts';
+import { entradaMarcarNoLlego, marcarNoLlego } from './ciclo.ts';
+
+/**
+ * F-412 + F-414 · Lo que el no-show ESCRIBE: el anticipo resuelto y el antecedente.
+ *
+ * `agenda.marcar_no_llego` recibía `retieneAnticipo` y sólo lo apuntaba en la bitácora: el
+ * anticipo se quedaba vivo para siempre y `no_shows` jamás recibía una fila, así que la clienta
+ * no acumulaba faltas y el «2 en seis meses enciende el aviso» no encendía nunca.
+ */
+
+const CITA = 'a1111111-1111-4111-8111-111111111111';
+const CLIENTA = 'c2222222-2222-4222-8222-222222222222';
+const KARLA = 'z1111111-1111-4111-8111-111111111111';
+const DANY = 'z2222222-2222-4222-8222-222222222222';
+const ANTICIPO = 'd1111111-1111-4111-8111-111111111111';
+const SESION_CAJA = 'e1111111-1111-4111-8111-111111111111';
+/** Cuando la clienta debía llegar: el miércoles a las 18:00 en México. */
+const DEBIA_LLEGAR = new Date('2026-09-16T00:00:00.000Z');
+/** Cuando se marcó, con retraso. */
+const AHORA = new Date('2026-09-16T00:20:00.000Z');
+
+const PRECIO_TINTE = 95_000n;
+const PRECIO_CORTE = 25_000n;
+
+function salon(extra: Partial<TablasFalsas> = {}): TablasFalsas {
+  return {
+    citas: [
+      {
+        id: CITA,
+        organizacion_id: ORG,
+        sucursal_id: SUCURSAL,
+        folio: 'CITA-9',
+        estado: 'agendada',
+        cliente_id: CLIENTA,
+        agendada_para: DEBIA_LLEGAR,
+      },
+    ],
+    cita_servicios: [
+      {
+        id: 'b1111111-1111-4111-8111-111111111111',
+        organizacion_id: ORG,
+        cita_id: CITA,
+        profesional_id: KARLA,
+        precio_centavos: PRECIO_TINTE,
+        estado: 'pendiente',
+        created_at: new Date('2026-09-10T10:00:00.000Z'),
+      },
+      {
+        id: 'b2222222-2222-4222-8222-222222222222',
+        organizacion_id: ORG,
+        cita_id: CITA,
+        profesional_id: DANY,
+        precio_centavos: PRECIO_CORTE,
+        estado: 'pendiente',
+        created_at: new Date('2026-09-10T10:00:01.000Z'),
+      },
+    ],
+    anticipos_cita: [],
+    no_shows: [],
+    sesiones_caja: [
+      {
+        id: SESION_CAJA,
+        organizacion_id: ORG,
+        sucursal_id: SUCURSAL,
+        terminal_id: TERMINAL,
+        estado: 'abierta',
+        serie: 'CC',
+        folio: null,
+        abierta_en: AHORA,
+        cerrada_en: null,
+        fondo_inicial_centavos: 80_000n,
+        efectivo_contado_centavos: null,
+      },
+    ],
+    movimientos_caja: [],
+    ...extra,
+  };
+}
+
+const anticipo = (metodo: 'efectivo' | 'tarjeta', monto = 28_500n) => ({
+  id: ANTICIPO,
+  organizacion_id: ORG,
+  cita_id: CITA,
+  cliente_id: CLIENTA,
+  monto_centavos: monto,
+  metodo,
+  estado: 'vivo',
+  resuelto_en: null,
+  motivo_resolucion: null,
+});
+
+const baseDe = (extra: Partial<TablasFalsas> = {}) =>
+  crearBaseFalsa(salon(extra), {
+    predeterminados: {
+      no_shows: { nota: null },
+      movimientos_caja: { referencia_id: null, empleado_id: null, motivo: null },
+    },
+  });
+
+async function codigoDe(fn: () => Promise<unknown>): Promise<string> {
+  try {
+    await fn();
+    return 'NO LANZÓ';
+  } catch (error) {
+    return esErrorDominio(error) ? error.codigo : `INESPERADO: ${String(error)}`;
+  }
+}
+
+describe('el no-show y el anticipo (§6.1: «el salón se lo queda»)', () => {
+  it('LO NORMAL: el anticipo se RETIENE, y no mueve el cajón: el dinero ya estaba', async () => {
+    const base = baseDe({ anticipos_cita: [anticipo('efectivo')] });
