@@ -0,0 +1,173 @@
+import { obtenerDb } from '@morphiqpos/data';
+import { beforeAll, describe, expect, it } from 'vitest';
+
+import { exigirOk } from '../pruebas/negocio-real.ts';
+import { conSalon } from './cabina.integracion.ayuda.ts';
+import {
+  EN_EL_ANAQUEL,
+  RINDE_G,
+  sembrarSalonConCabina,
+  SHAMPOO_EN_EL_ANAQUEL,
+  SHAMPOO_EN_LA_CABINA,
+  TUBO_CENTAVOS,
+  type SalonConCabina,
+} from './cabina.integracion.siembra.ts';
+
+/**
+ * F-154 + F-155 · LA CABINA DE PUNTA A PUNTA, contra Postgres.
+ *
+ * Abrir una pieza, ligarla a la fórmula y cerrar el servicio es un camino de SQL que los
+ * dobles en memoria no pueden ver, y por eso se quedó roto sin que nada lo dijera:
+ *
+ *   · `abrir_producto` escribía el movimiento de entrada con su frase en `motivo`, y
+ *     `movimientos_stock_motivo_conocido` es una foránea a las claves de merma: contra
+ *     Postgres de verdad contestaba 500 (23503);
+ *   · sólo escribía el ledger: el saldo de `existencias` no se movía, ni el del anaquel ni
+ *     el de la cabina;
+ *   · `cerrar_servicio` sacaba el producto del almacén PRINCIPAL —el anaquel— y a su costo
+ *     por pieza aplicado a gramos.
+ *
+ * Aquí cada afirmación es sobre las filas que quedaron, no sobre lo que el comando dijo.
+ */
+
+let salon: SalonConCabina;
+let s: ReturnType<typeof conSalon>;
+/** El servicio del primer cierre, el que sí tenía fórmula: se vuelve a cerrar. */
+let servicioYaCerrado = '';
+
+beforeAll(async () => {
+  salon = await sembrarSalonConCabina('Salón de la Cabina');
+  s = conSalon(salon);
+});
+
+describe('F-155 · abrir una pieza mueve los DOS saldos y escribe el traspaso', () => {
+  it('el anaquel baja una pieza, la cabina sube sus 100 g, y el ledger lo cuenta con su costo', async () => {
+    const salida = exigirOk(await s.abrir(), 'cabina.abrir_producto');
+
+    expect(salida.unidadCabina).toBe('g');
+    expect(await s.existenciaDelTinte(salon.almacenDeVenta)).toBe(EN_EL_ANAQUEL - 1);
+    expect(await s.existenciaDelTinte(salon.almacenDeCabina)).toBe(RINDE_G);
+
+    const movimientos = await s.movimientosDelTinte();
+    const sale = movimientos.find((m) => m.tipo === 'traspaso_salida');
+    const entra = movimientos.find((m) => m.tipo === 'traspaso_entrada');
+    expect(sale).toMatchObject({
+      tipo: 'traspaso_salida',
+      almacen_id: salon.almacenDeVenta,
+      unidad: 'pieza',
+      costo_unitario_centavos: TUBO_CENTAVOS,
+      motivo: null,
+    });
+    expect(Number(sale?.cantidad)).toBe(-1);
+    // 13 100 centavos entre 100 g: 131 el gramo, no 13 100.
+    expect(entra).toMatchObject({
+      tipo: 'traspaso_entrada',
+      almacen_id: salon.almacenDeCabina,
+      unidad: 'g',
+      costo_unitario_centavos: 131n,
+      motivo: null,
+    });
+    expect(Number(entra?.cantidad)).toBe(RINDE_G);
+    expect(entra?.nota).toBe('apertura para cabina de Tinte permanente castaño 6.0');
+    // Y NADA MÁS se movió: el otro insumo de los mismos dos almacenes sigue como estaba.
+    expect(await s.elTestigo()).toEqual({
+      anaquel: SHAMPOO_EN_EL_ANAQUEL,
+      cabina: SHAMPOO_EN_LA_CABINA,
+    });
+  });
+
+  it('SIN LAS PIEZAS EN EL ANAQUEL no se abre, y no queda nada a medias', async () => {
+    const antes = (await s.movimientosDelTinte()).length;
+
+    // Quedan 4 en el anaquel: pedir 10 es abrir lo que no está.
+    const salida = await s.abrir(10);
+
+    expect(salida.ok).toBe(false);
+    if (salida.ok) return;
+    expect(salida.error.datos?.['regla']).toBe('STOCK_INSUFICIENTE');
+    expect((await s.movimientosDelTinte()).length).toBe(antes);
+    expect(await s.existenciaDelTinte(salon.almacenDeVenta)).toBe(EN_EL_ANAQUEL - 1);
+    expect(await s.existenciaDelTinte(salon.almacenDeCabina)).toBe(RINDE_G);
+  });
+
+  it('ABRIR OTRA PIEZA SUMA a lo que ya había en la cabina: no la deja en lo que rinde una', async () => {
+    // El saldo de la cabina nace en cero sólo si no existía: `on conflict do nothing`, no `do update`.
+    exigirOk(await s.abrir(), 'segunda apertura');
+
+    expect(await s.existenciaDelTinte(salon.almacenDeCabina)).toBe(RINDE_G * 2);
+    expect(await s.existenciaDelTinte(salon.almacenDeVenta)).toBe(EN_EL_ANAQUEL - 2);
+    expect(await s.elTestigo()).toEqual({
+      anaquel: SHAMPOO_EN_EL_ANAQUEL,
+      cabina: SHAMPOO_EN_LA_CABINA,
+    });
+  });
+});
+
+describe('F-154 · cerrar el servicio gasta DE LA CABINA lo que dice la fórmula', () => {
+  it('70 g de la fórmula salen de la cabina, a 131 centavos el gramo, y el anaquel no se toca', async () => {
+    const { citaId, servicioDeLaCita } = await s.citaConServicio('2026-12-02T16:00:00.000Z');
+    // El «ml» que se escribe se corrige a la unidad del PRODUCTO: los gramos no se descuentan de mililitros.
+    exigirOk(await s.capturar(citaId, 70, 'ml'), 'expediente.capturar_formula');
+    const anaquelAntes = await s.existenciaDelTinte(salon.almacenDeVenta);
+    const cabinaAntes = await s.existenciaDelTinte(salon.almacenDeCabina);
+
+    const cierre = exigirOk(await s.cerrar(servicioDeLaCita), 'agenda.cerrar_servicio');
+
+    servicioYaCerrado = servicioDeLaCita;
+    expect(cierre.consumos).toBe(1);
+    expect(await s.existenciaDelTinte(salon.almacenDeCabina)).toBe(cabinaAntes - 70);
+    expect(await s.existenciaDelTinte(salon.almacenDeVenta)).toBe(anaquelAntes);
+    const consumo = (await s.movimientosDelTinte()).find((m) => m.tipo === 'consumo_servicio');
+    expect(consumo).toMatchObject({
+      almacen_id: salon.almacenDeCabina,
+      unidad: 'g',
+      costo_unitario_centavos: 131n,
+      motivo: null,
+    });
+    expect(Number(consumo?.cantidad)).toBe(-70);
+    // La fórmula quedó LIGADA al producto y en SU unidad —no en la «ml» que llegó—.
+    expect((await s.formulaGuardada(citaId)).componentes[0]).toEqual({
+      nombre: '6.0',
+      cantidad: 70,
+      unidad: 'g',
+      productoId: salon.tinteId,
+    });
+    expect(await s.elTestigo()).toEqual({
+      anaquel: SHAMPOO_EN_EL_ANAQUEL,
+      cabina: SHAMPOO_EN_LA_CABINA,
+    });
+  });
+
+  it('CERRAR OTRA VEZ no descuenta otra vez: el teléfono pierde red y reintenta', async () => {
+    const antes = await s.existenciaDelTinte(salon.almacenDeCabina);
+    const movimientosAntes = (await s.movimientosDelTinte()).length;
+
+    const otra = exigirOk(await s.cerrar(servicioYaCerrado), 'segundo cierre');
+
+    // Con la fórmula todavía ahí, descontar de nuevo sería fácil: es lo que se impide.
+    expect(otra.consumos).toBe(0);
+    expect(await s.existenciaDelTinte(salon.almacenDeCabina)).toBe(antes);
+    expect((await s.movimientosDelTinte()).length).toBe(movimientosAntes);
+  });
+
+  it('SI LA CABINA NO ALCANZA el cierre falla entero: el servicio sigue abierto y no se gasta nada', async () => {
+    const { citaId, servicioDeLaCita } = await s.citaConServicio('2026-12-02T20:00:00.000Z');
+    exigirOk(await s.capturar(citaId, 500), 'expediente.capturar_formula');
+    const antes = await s.existenciaDelTinte(salon.almacenDeCabina);
+    const movimientosAntes = (await s.movimientosDelTinte()).length;
+
+    const salida = await s.cerrar(servicioDeLaCita);
+
+    expect(salida.ok).toBe(false);
+    if (salida.ok) return;
+    expect(salida.error.datos?.['regla']).toBe('STOCK_INSUFICIENTE');
+    expect(await s.existenciaDelTinte(salon.almacenDeCabina)).toBe(antes);
+    expect((await s.movimientosDelTinte()).length).toBe(movimientosAntes);
+    const servicio = await obtenerDb()
+      .selectFrom('cita_servicios')
+      .select('estado')
+      .where('id', '=', servicioDeLaCita)
+      .executeTakeFirstOrThrow();
+    expect(servicio.estado).not.toBe('cerrado');
+  });
+});
