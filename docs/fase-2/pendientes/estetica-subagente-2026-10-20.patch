+  });
+
+  it('un servicio sin nombre no se ofrece por nombre, pero la cita se sigue contando', () => {
+    const [cita] = citasSinLlegar([bloque({ servicio: null })], DIA, A_LAS('18:30'));
+    if (cita === undefined) throw new Error('La cita debía estar sin llegar.');
+    expect(cita.servicios).toBe('Servicio');
+    expect(huecoQueDejo(cita, DIA).servicios).toEqual([]);
+  });
+
+  it('es el hueco que la lista de espera entiende: sirve a quien lo pidió y no a quien pidió otra cosa', () => {
+    const [cita] = citasSinLlegar([bloque({ servicio: 'Peinado de evento' })], DIA, A_LAS('18:30'));
+    if (cita === undefined) throw new Error('La cita debía estar sin llegar.');
+    const hueco = huecoQueDejo(cita, DIA);
+    // La ventana «toda la tarde», armada con la hora local de la prueba como la cita.
+    const cuando = {
+      desde: new Date(A_LAS('12:00')).toISOString(),
+      hasta: new Date(A_LAS('23:59')).toISOString(),
+    };
+
+    const paola = espera({ esperaId: 'paola', ...cuando, profesionalNombre: 'Karla' });
+    const conOtra = espera({ esperaId: 'otra', ...cuando, profesionalNombre: 'Dany' });
+    const otroServicio = espera({ esperaId: 'tinte', ...cuando, servicioNombre: 'Tinte' });
+    const cualquiera = espera({ esperaId: 'cualquiera' });
+    const yaPaso = espera({
+      esperaId: 'ayer',
+      desde: '2026-09-10T12:00:00.000Z',
+      hasta: '2026-09-11T12:00:00.000Z',
