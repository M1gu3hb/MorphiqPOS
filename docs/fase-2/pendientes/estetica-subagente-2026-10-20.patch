diff --git a/apps/web/src/estetica-salon/productos-del-salon.ts b/apps/web/src/estetica-salon/productos-del-salon.ts
index 6e664be..d6e168f 100644
--- a/apps/web/src/estetica-salon/productos-del-salon.ts
+++ b/apps/web/src/estetica-salon/productos-del-salon.ts
@@ -12,3 +12,62 @@ export function sinServicios<T extends { readonly duracion_activa_1_min?: number
 ): readonly T[] {
   return filas.filter((p) => p.duracion_activa_1_min == null);
 }
+
+/** Un rendimiento escrito en la ficha: hasta seis enteros y cuatro decimales, con punto o coma. */
+export const CANTIDAD_CON_FORMA = /^\d{1,6}(?:[.,]\d{1,4})?$/;
+
+/**
+ * Lo que le falta a la ficha ESCRITA EN EL FORMULARIO para que el producto entre a cabina.
+ *
+ * ── Por qué existe ───────────────────────────────────────────────────────────────────
+ * Un producto «Sólo se vende» no enseña la ficha de cabina —no la necesita— y el destino se
+ * guardaba al TOCAR su botón. Para pasar un producto a «Sólo se usa» o «Las dos cosas» había
+ * que tocar el botón; el servidor lo rechazaba («un producto que entra a cabina necesita
+ * cuánto rinde al abrirse»), la ficha no aparecía, y sin ficha no había cómo decir cuánto
+ * rinde: el círculo no tenía salida. Ningún producto podía entrar a cabina desde la pantalla,
+ * justo lo que su estado vacío le pide al usuario que haga.
+ *
+ * Con esto, tocar un destino que entra a cabina sin la ficha completa NO guarda: enseña la
+ * ficha, y el destino se guarda junto con ella.
+ *
+ * `venta` no necesita ficha, y se dice de una vez. Un rendimiento en cero se trata como
+ * faltante: el servidor lo rechaza igual, y un cero que pasa vuelve gratis cada gramo.
+ */
+export function faltaEnLaFicha(destino: string, factor: string, unidad: string): readonly string[] {
+  if (destino !== 'cabina' && destino !== 'ambos') return [];
+  const huecos: string[] = [];
+  const rinde = factor.trim();
+  if (!CANTIDAD_CON_FORMA.test(rinde) || Number(rinde.replace(',', '.')) <= 0) {
+    huecos.push('cuánto rinde al abrirse');
+  }
+  if (unidad.trim() === '') huecos.push('en qué se mide en cabina');
+  return huecos;
+}
+
+/**
+ * Cuántos decimales TIENE de verdad un número que llega del servidor, hasta cuatro.
+ *
+ * Una columna `numeric(14,4)` llega con sus cuatro decimales aunque el valor sea entero
+ * —`'100.0000'`—: contarlos tal cual pintaba «Hay abierto 100.0000 g» donde hay cien gramos.
+ * Los ceros de la cola no son decimales; `'62.5000'` tiene uno.
+ */
+export function decimalesDe(valor: number | string): number {
+  const texto = String(valor);
+  const [, fraccion = ''] = (texto.includes('.') ? texto.replace(/0+$/, '') : texto).split('.');
+  return Math.min(fraccion.length, 4);
+}
+
+/**
+ * Lo que cada tipo de movimiento ES dentro de la CABINA, dicho como lo diría quien la cuida: lo
+ * que entra es una pieza que se abrió, y lo que sale es lo que se gastó en una fórmula. Los
+ * tipos son los de `movimientos_stock`; uno que no esté aquí se enseña con su clave, y no se
+ * esconde.
+ */
+export const QUE_PASO_EN_LA_CABINA: Readonly<Record<string, string>> = {
+  traspaso_entrada: 'Entró de una pieza abierta',
+  consumo_servicio: 'Gastado en una fórmula',
+  traspaso_salida: 'Salió a otro almacén',
+  ajuste: 'Ajuste de conteo',
+  merma: 'Merma',
+  inventario_inicial: 'Inventario inicial',
+};
