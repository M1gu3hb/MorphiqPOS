+import { esperasParaElHueco, type EsperaViva } from './lista-de-espera.ts';
+import {
+  MINUTOS_DE_ESPERA_EXTRA,
+  MINUTOS_DE_TOLERANCIA,
+  aplazarHasta,
+  citasSinLlegar,
+  huecoQueDejo,
+  loQuePasaraConElAnticipo,
+  loQueQuedoDelNoLlego,
