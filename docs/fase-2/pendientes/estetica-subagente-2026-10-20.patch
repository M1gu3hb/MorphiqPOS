+    const tarjeta = loQueQuedoDelNoLlego(
+      cita,
+      resultado({ anticipo: { estado: 'devuelto', montoCentavos: '28500', metodo: 'tarjeta' } }),
+      pesos,
+    );
+    expect(tarjeta.lineas.join(' ')).toContain('por el mismo medio con que lo dio');
+  });
+
+  it('sin anticipo no inventa uno', () => {
+    const { lineas } = loQueQuedoDelNoLlego(cita, resultado(), pesos);
+    expect(lineas.join(' ')).not.toContain('anticipo');
+  });
+
+  it('las faltas son graduadas: 1 es humano, 2 enciende el aviso, 3 pide anticipo', () => {
+    const dice = (faltas: number) =>
+      loQueQuedoDelNoLlego(cita, resultado({ faltasEnSeisMeses: faltas }), pesos).lineas.join(' ');
+    expect(dice(1)).toContain('primera falta');
+    expect(dice(2)).toContain('segunda falta en seis meses: enciende el aviso');
+    expect(dice(3)).toContain('Van 3 faltas en seis meses: la próxima vez se le pide anticipo');
+    expect(dice(5)).toContain('Van 5 faltas');
+    // Sin clienta con ficha no hay cuenta de faltas que decir.
+    expect(dice(0)).not.toContain('falta');
+  });
+
+  it('sin nombre de clienta, «La clienta»; y siempre lo que valía', () => {
+    const sin = loQueQuedoDelNoLlego({ ...cita, clienta: null }, resultado(), pesos);
+    expect(sin.titulo.startsWith('La clienta no llegó')).toBe(true);
+    expect(sin.lineas[0]).toBe('Lo que valía la cita: $950.00.');
