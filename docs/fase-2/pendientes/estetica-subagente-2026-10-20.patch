+    expect(citasSinLlegar([bloque()], '2026-09-15', A_LAS('00:10'))).toHaveLength(1);
+  });
+});
+
+describe('«va en camino»', () => {
+  it('aplaza la pregunta unos minutos y después vuelve a hacerla', () => {
+    const aplazadas = new Map([['cita-1', aplazarHasta(A_LAS('18:20'))]]);
+    // Mientras dura el aplazamiento, no se pregunta…
+    expect(citasSinLlegar([bloque()], DIA, A_LAS('18:30'), aplazadas)).toEqual([]);
+    expect(citasSinLlegar([bloque()], DIA, A_LAS('18:34'), aplazadas)).toEqual([]);
