 }
+
+/**
+ * Liga un componente a un bote de la cabina, o lo suelta, sin mutar la mezcla.
+ *
+ * Al ligarlo la unidad pasa a ser la de la CABINA: «6.0 · 70 ml» ligado a un tinte que se
+ * cuenta en gramos descontaría setenta de algo que no es lo que se pesó, y el servidor la
+ * fija igual (`formula.ts`). Soltarlo deja la unidad como estaba —es la que la estilista
+ * ya veía— y quita la liga: el componente vuelve a ser sólo expediente.
+ */
+export function ligar(mezcla: Mezcla, indice: number, material: MaterialDeCabina | null): Mezcla {
+  const componentes = mezcla.componentes.map((c, i): ComponenteDeFormula => {
+    if (i !== indice) return c;
+    // Sin la liga y sin nada más: se arma el componente de nuevo en vez de «quitarle» la
+    // propiedad, que obligaría a una variable que nadie usa.
+    if (material === null) return { nombre: c.nombre, cantidad: c.cantidad, unidad: c.unidad };
+    return { ...c, productoId: material.productoId, unidad: material.unidad };
+  });
+  return { ...mezcla, componentes };
+}
+
+/** Lo que de `cabina.existencias` sirve para elegir de qué bote salió un material. */
+export interface ExistenciaDeCabina {
+  readonly productoId: string;
+  readonly nombre: string;
+  /** En la unidad de cabina; nulo si el producto no se abre en cabina. */
+  readonly enCabina: string | null;
+  readonly unidadCabina: string | null;
+}
+
+/** Los materiales de la cabina: los que se abren en ella, con lo que hay, ya en su unidad. */
+export function materialesDeCabina(
+  existencias: readonly ExistenciaDeCabina[],
+): readonly MaterialDeCabina[] {
+  return existencias
+    .flatMap((e): readonly MaterialDeCabina[] =>
+      e.enCabina === null || e.unidadCabina === null
+        ? []
+        : [
+            {
+              productoId: e.productoId,
+              nombre: e.nombre,
+              hay: String(Number(e.enCabina)),
+              unidad: e.unidadCabina,
+            },
+          ],
+    )
+    .toSorted((a, b) => a.nombre.localeCompare(b.nombre, 'es-MX'));
+}
