new file mode 100644
index 0000000..eac4066
--- /dev/null
+++ b/apps/web/src/estetica-salon/WalkIn.tsx
@@ -0,0 +1,207 @@
+'use client';
+
+import { Button } from '@morphiqpos/ui/primitivas/button';
+import { Input } from '@morphiqpos/ui/primitivas/input';
+import { Label } from '@morphiqpos/ui/primitivas/label';
+import {
+  Sheet,
+  SheetContent,
+  SheetDescription,
+  SheetFooter,
+  SheetHeader,
+  SheetTitle,
+} from '@morphiqpos/ui/primitivas/sheet';
+import { Aviso, EsqueletoDeLista, Vacio } from '@morphiqpos/ui/sistema';
+import { Scissors } from 'lucide-react';
+
+import { useWalkIn } from './walk-in-estado.ts';
+
+/**
+ * LA WALK-IN EN DOS TOQUES (F-413; `04-INTERFAZ §4.3.6`): la clienta llegó sin cita, la estilista
+ * o la recepción la toma sin caminar a ningún lado.
+ *
+ * ── Dos toques, no un formulario ─────────────────────────────────────────────────
+ * Para la estilista: elige el servicio —sólo se le ofrecen los suyos— y toca «Empezar ahora».
+ * La recepción, además, dice con quién si hay más de una que lo da. El nombre es opcional:
+ * «con clienta si se puede, sin clienta si tiene prisa»; sin él se atiende y se cobra sin ficha.
+ *
+ * ── Qué hace «empezar» ───────────────────────────────────────────────────────────
+ * Agenda la cita AHORA, con la hora del servidor, y la inicia: es una cita que nació hace
+ * treinta segundos y ya está sentada (`walk-in.ts`). Si agendar falla —choque con otra cita,
+ * por ejemplo— se dice el motivo y nada queda; si sólo falla empezar, la cita queda agendada y
+ * la hoja manda a la agenda.
+ */
+
+export interface WalkInProps {
+  readonly alCerrar: () => void;
+  /** Puede dar de alta a la clienta que dé su nombre: la recepción sí, la estilista no. */
+  readonly conFicha: boolean;
+  /** Por quién se abrió (su «Mi día»): la que se propone si hay varias. */
+  readonly paraQuien: string | null;
+}
+
+export function WalkIn({ alCerrar, conFicha, paraQuien }: WalkInProps) {
+  const w = useWalkIn(paraQuien, alCerrar);
+  const { catalogo } = w;
+  const nombreDe = (id: string | null): string =>
+    w.opciones.find((persona) => persona.id === id)?.nombre ?? '';
+
+  return (
+    <Sheet
+      open
+      onOpenChange={(abierta) => {
+        if (!abierta && !w.enviando) alCerrar();
+      }}
+    >
+      <SheetContent
+        side="bottom"
+        showCloseButton={false}
+        className="max-h-[92dvh] overflow-y-auto p-(--espacio-4) md:mx-auto md:max-w-2xl"
+      >
+        <SheetHeader className="p-0">
+          <SheetTitle className="text-lg">Tomar una walk-in</SheetTitle>
+          <SheetDescription>Sin cita: se agenda ahora, ocupa el hueco y empieza.</SheetDescription>
+        </SheetHeader>
+
+        {catalogo.estado === 'leyendo' ? (
+          <EsqueletoDeLista filas={3} />
+        ) : catalogo.estado === 'fallo' ? (
+          <Aviso
+            tono="peligro"
+            titulo="No se pudo leer lo necesario para tomar la walk-in."
+            accion={
+              <Button size="sm" variant="outline" onClick={w.volverALeer}>
+                Volver a intentar
+              </Button>
+            }
+          >
+            {catalogo.mensaje} No se agendó nada.
+          </Aviso>
+        ) : w.servicios.length === 0 ? (
+          <Vacio
+            tamano="compacto"
+            icono={<Scissors />}
+            titulo={
+              w.fija === null
+                ? 'Todavía no hay servicios que alguien dé.'
+                : 'No tienes servicios asignados.'
+            }
+            explicacion="Se asignan en el catálogo de servicios, en «Quién lo da»."
+          />
+        ) : (
+          <div className="flex flex-col gap-(--espacio-4)">
+            <section aria-label="¿Qué quiere?" className="flex flex-col gap-(--espacio-2)">
+              <h3 className="text-sm font-semibold">¿Qué quiere?</h3>
+              <ul className="grid grid-cols-2 gap-(--espacio-2) md:grid-cols-3">
+                {w.servicios.map((servicio) => (
+                  <li key={servicio.id}>
+                    <Button
+                      variant={servicio.id === w.servicioId ? 'default' : 'outline'}
+                      aria-pressed={servicio.id === w.servicioId}
+                      className="min-h-[calc(var(--altura-control)*1.3)] w-full whitespace-normal"
+                      onClick={() => {
+                        w.elegirServicio(servicio.id);
+                      }}
+                    >
+                      {servicio.nombre}
+                    </Button>
+                  </li>
+                ))}
+              </ul>
+            </section>
+
+            {w.opciones.length > 1 ? (
+              <section aria-label="¿Con quién?" className="flex flex-col gap-(--espacio-2)">
+                <h3 className="text-sm font-semibold">¿Con quién?</h3>
+                <ul className="flex flex-wrap gap-(--espacio-2)">
+                  {w.opciones.map((persona) => (
+                    <li key={persona.id}>
+                      <Button
+                        variant={persona.id === w.quien ? 'default' : 'outline'}
+                        aria-pressed={persona.id === w.quien}
+                        className="min-h-[calc(var(--altura-control)*1.1)]"
+                        onClick={() => {
+                          w.elegirPersona(persona.id);
+                        }}
+                      >
+                        {persona.nombre}
+                      </Button>
+                    </li>
+                  ))}
+                </ul>
+              </section>
+            ) : w.fija === null && w.opciones.length === 1 ? (
+              <p className="text-sm text-texto-sutil">La atiende {nombreDe(w.quien)}.</p>
+            ) : null}
+
+            {conFicha ? (
+              <section aria-label="La clienta" className="flex flex-col gap-(--espacio-2)">
+                <h3 className="text-sm font-semibold">¿Cómo se llama? (opcional)</h3>
+                <div className="grid grid-cols-2 gap-(--espacio-2)">
+                  <div className="flex flex-col gap-(--espacio-1)">
+                    <Label htmlFor="walk-in-nombre" className="text-xs">
+                      Nombre
+                    </Label>
+                    <Input
+                      id="walk-in-nombre"
+                      value={w.nombre}
+                      disabled={w.enviando}
+                      onChange={(evento) => {
+                        w.setNombre(evento.target.value);
+                      }}
+                    />
+                  </div>
+                  <div className="flex flex-col gap-(--espacio-1)">
+                    <Label htmlFor="walk-in-telefono" className="text-xs">
+                      Teléfono
+                    </Label>
+                    <Input
+                      id="walk-in-telefono"
+                      type="tel"
+                      value={w.telefono}
+                      disabled={w.enviando}
+                      onChange={(evento) => {
+                        w.setTelefono(evento.target.value);
+                      }}
+                    />
+                  </div>
+                </div>
+                <p className="text-xs text-texto-sutil">
+                  Si no lo da ahora, se atiende y se cobra sin ficha.
+                </p>
+              </section>
+            ) : null}
+          </div>
+        )}
+
+        {w.fallo === null ? null : (
+          <Aviso tono="peligro" titulo={w.fallo}>
+            No se agendó nada.
+          </Aviso>
+        )}
+        {w.aMedias === null ? null : (
+          <Aviso
+            tono="atencion"
+            titulo="La walk-in quedó agendada, pero no se pudo empezar."
+            accion={
+              <Button size="sm" variant="outline" onClick={w.irALaAgenda}>
+                Ver la agenda
+              </Button>
+            }
+          >
+            {w.aMedias.falloAlEmpezar}
+          </Aviso>
+        )}
+
+        <SheetFooter className="p-0 md:flex-row md:justify-end">
+          <Button variant="outline" disabled={w.enviando} onClick={alCerrar}>
+            Cancelar
+          </Button>
+          <Button size="lg" disabled={!w.puedeEmpezar} onClick={w.empezar}>
+            {w.enviando ? 'Empezando…' : 'Empezar ahora'}
+          </Button>
+        </SheetFooter>
+      </SheetContent>
+    </Sheet>
+  );
+}
