+ */
+describe('el costo por unidad de cabina', () => {
+  it('una pieza que rinde 100 g y cuesta $131 cuesta $1.31 el gramo', () => {
+    expect(costoPorUnidadDeCabina(13_100n, '100.0000')).toBe(131n);
+  });
+
+  it('un litro de $310 que rinde 1000 ml cuesta 31 centavos el ml', () => {
+    expect(costoPorUnidadDeCabina(31_000n, '1000.0000')).toBe(31n);
+  });
+
+  it('REDONDEA LA MITAD HACIA ARRIBA, el redondeo único del sistema', () => {
+    // 13 100 / 60 = 218.33…: abajo. 100 / 8 = 12.5 y 101 / 8 = 12.625: arriba.
+    expect(costoPorUnidadDeCabina(13_100n, '60')).toBe(218n);
+    expect(costoPorUnidadDeCabina(100n, '8')).toBe(13n);
+    expect(costoPorUnidadDeCabina(101n, '8')).toBe(13n);
+    expect(costoPorUnidadDeCabina(99n, '8')).toBe(12n);
+  });
+
+  it('un rendimiento con decimales se respeta: 0.5 de pieza son el doble por unidad', () => {
+    expect(costoPorUnidadDeCabina(1_000n, '0.5')).toBe(2_000n);
+  });
+
+  it('SIN RENDIMIENTO VÁLIDO no se inventa un costo: se dice', () => {
+    for (const factor of ['0', '0.0000', '']) {
+      let fallo: unknown = null;
+      try {
+        costoPorUnidadDeCabina(13_100n, factor);
+      } catch (error) {
+        fallo = error;
+      }
+      expect(esErrorDominio(fallo) && fallo.codigo, `«${factor}»`).toBe('CATALOGO_INVALIDO');
+    }
+  });
+
+  it('un costo de cero sigue en cero: la pieza regalada no cuesta', () => {
+    expect(costoPorUnidadDeCabina(0n, '100')).toBe(0n);
+  });
+});
+
+describe('los cuatro decimales de la cabina', () => {
+  it('van y vienen sin pasar por coma flotante', () => {
+    expect(aEscala('62.5')).toBe(625_000n);
+    expect(deEscala(aEscala('62.5'))).toBe('62.5000');
+    expect(aEscala('0.0001')).toBe(1n);
+    expect(deEscala(1n)).toBe('0.0001');
+    expect(deEscala(aEscala('100'))).toBe('100.0000');
+  });
+
+  it('un quinto decimal no entra: se corta, no se redondea hacia un valor que nadie capturó', () => {
+    expect(aEscala('1.23456')).toBe(12_345n);
+  });
+});
+
+/**
+ * `existencias` NO se deriva de `movimientos_stock`: cada comando mueve el saldo y escribe el
+ * ledger. Mover el saldo es SQL crudo y la base falsa no lo ejecuta, así que se afirma sobre el
+ * SQL COMPILADO de un Kysely real: la guarda va en el MISMO `update`, y el saldo nace en cero
+ * antes de sumarle.
+ */
+describe('mover la existencia de un insumo', () => {
+  const ALMACEN = 'a1111111-1111-4111-8111-111111111111';
+  const INSUMO = 'b1111111-1111-4111-8111-111111111111';
+  const PRODUCTO = 'c1111111-1111-4111-8111-111111111111';
+
+  async function mover(respuestas: readonly (readonly unknown[])[], delta: string) {
+    const { tx, conexion } = transaccionGrabadora(respuestas);
+    const { ctx } = contextoFalso(tx, ambitoDe('gerente'));
+    const promesa = moverExistencia(ctx, {
+      almacenId: ALMACEN,
+      insumoId: INSUMO,
+      delta,
+      sinExistencia: 'No hay de eso.',
+      detallesDelFallo: { productoId: PRODUCTO },
+    });
+    return { promesa, conexion };
+  }
+
+  it('PRIMERO nace en cero (sin pisar lo que haya) y DESPUÉS se mueve, con su guarda adentro', async () => {
+    const { promesa, conexion } = await mover([[], [{ cantidad: '21.0000' }]], '-1');
+    await promesa;
+
+    const [nace, mueve] = conexion.consultas;
+    expect(nace?.sql).toMatch(
+      /insert into existencias \(organizacion_id, almacen_id, insumo_id, cantidad\)/,
+    );
+    expect(nace?.sql).toMatch(/values \(\$1, \$2, \$3, 0\)/);
+    // `do nothing`: una existencia que ya está NO se vuelve a cero.
+    expect(nace?.sql).toMatch(/on conflict \(almacen_id, insumo_id\) do nothing/);
+    expect(nace?.parameters).toEqual([ORG, ALMACEN, INSUMO]);
+
+    expect(mueve?.sql).toMatch(/update existencias\s+set cantidad = cantidad \+ \$1/);
+    expect(mueve?.sql).toMatch(
+      /where organizacion_id = \$2\s+and almacen_id = \$3\s+and insumo_id = \$4\s+and cantidad \+ \$5 >= 0\s+returning cantidad/,
+    );
+    // El mismo delta va en la suma y en la guarda: lo que se resta es lo que se comprueba.
+    expect(mueve?.parameters).toEqual(['-1', ORG, ALMACEN, INSUMO, '-1']);
+    expect(conexion.consultas).toHaveLength(2);
+  });
+
+  it('un delta con decimales se manda tal cual, sin pasar por coma flotante', async () => {
+    const { promesa, conexion } = await mover([[], [{ cantidad: '30.0000' }]], '-70.0000');
+    await promesa;
+    expect(conexion.consultas[1]?.parameters).toEqual([
+      '-70.0000',
+      ORG,
+      ALMACEN,
+      INSUMO,
+      '-70.0000',
+    ]);
+  });
+
+  it('SI NO ALCANZA (el update no toca ninguna fila) FALLA con su aviso y de QUÉ producto', async () => {
+    const { promesa } = await mover([[], []], '-3');
+
+    const fallo = await promesa.catch((e: unknown) => e);
+
+    expect(esErrorDominio(fallo) && fallo.codigo).toBe('STOCK_INSUFICIENTE');
+    expect(esErrorDominio(fallo) && fallo.message).toBe('No hay de eso.');
+    expect(esErrorDominio(fallo) && fallo.detalles).toEqual({
+      insumoId: INSUMO,
+      productoId: PRODUCTO,
+    });
+  });
+
+  it('SUMAR siempre se puede: la cabina que recibe no necesita existencia previa', async () => {
+    const { promesa, conexion } = await mover([[], [{ cantidad: '100.0000' }]], '100.0000');
+    await expect(promesa).resolves.toBeUndefined();
+    expect(conexion.consultas[1]?.parameters[0]).toBe('100.0000');
+  });
+});
diff --git a/packages/app/src/salon/existencias-de-cabina.ts b/packages/app/src/salon/existencias-de-cabina.ts
new file mode 100644
index 0000000..1a3a349
--- /dev/null
+++ b/packages/app/src/salon/existencias-de-cabina.ts
@@ -0,0 +1,112 @@
+import 'server-only';
+
+import { ErrorDominio, type DetallesError } from '@morphiqpos/contracts';
+import type { Transaccion } from '@morphiqpos/data';
+import { sql } from 'kysely';
+
+import type { ContextoComando } from '../definicion.ts';
+
+/**
+ * LO QUE ABRIR UNA PIEZA Y GASTARLA EN UN SERVICIO TIENEN EN COMÚN: mover la existencia
+ * del almacén que toca con su guarda, y poner el costo en la unidad en que se cuenta.
+ *
+ * ── Por qué vive aparte de `cabina.ts` y `ciclo.ts` ───────────────────────────────────
+ * Los dos movían producto de cabina y cada uno lo hacía a su manera: `cerrar_servicio`
+ * actualizaba `existencias` y escribía el movimiento; `abrir_producto` sólo escribía el
+ * movimiento. Con una sola puerta, el saldo y el ledger no pueden separarse.
+ *
+ * ── El ledger sin el saldo, y por qué importa ─────────────────────────────────────────
+ * `existencias` NO se deriva de `movimientos_stock`: no hay disparador, cada comando
+ * escribe las dos cosas. Abrir una pieza escribía el traspaso y dejaba el saldo como
+ * estaba, así que el anaquel no bajaba ni la cabina subía: con el kardex diciendo que
+ * entraron cien gramos, «¿alcanza?» contestaba que había cero y el primer servicio que los
+ * gastaba fallaba con `STOCK_INSUFICIENTE`.
+ *
+ * ── El costo va por unidad de CABINA, no por pieza ────────────────────────────────────
+ * El insumo guarda lo que cuesta UNA PIEZA ($131 el tubo). Aplicado a los gramos del
+ * servicio, 70 g de tinte salían en $9,170 de material para un servicio de $650, y el
+ * corte y la comisión que descuenta material lo repetían. Una pieza que rinde 100 g cuesta
+ * 131 centavos el gramo: el costo se reparte entre lo que rinde al abrirse (`03-INVENTARIO
+ * §3.1`: «CABINA +1,000 ml, a $0.31/ml»).
+ */
+
+/** Cuatro decimales, como `numeric(14,4)` en `existencias` y `movimientos_stock`. */
+export const ESCALA = 10_000n;
+
+/** Un decimal de texto a enteros de cuatro decimales: `'62.5'` → `625000n`. */
+export function aEscala(valor: string): bigint {
+  const [entero = '0', decimal = ''] = valor.trim().split('.');
+  return BigInt(entero) * ESCALA + BigInt(decimal.padEnd(4, '0').slice(0, 4));
+}
+
+/** Enteros de cuatro decimales a texto: `625000n` → `'62.5000'`. */
+export function deEscala(valor: bigint): string {
+  const entero = valor / ESCALA;
+  const resto = (valor % ESCALA).toString().padStart(4, '0');
+  return `${String(entero)}.${resto}`;
+}
+
+/**
+ * Lo que cuesta una unidad de cabina, en centavos enteros: el costo de la pieza entre lo
+ * que rinde al abrirse, con la mitad hacia arriba (el redondeo único del sistema, D-36).
+ *
+ * Sin rendimiento válido NO se inventa un costo: se dice, porque un cero aquí vuelve el
+ * material gratis y un costo por pieza lo multiplica por el rendimiento.
+ */
+export function costoPorUnidadDeCabina(costoPorPiezaCentavos: bigint, factor: string): bigint {
+  const rendimiento = aEscala(factor);
+  if (rendimiento <= 0n) {
+    throw new ErrorDominio(
+      'CATALOGO_INVALIDO',
+      'El producto no dice cuánto rinde al abrirse: sin eso no se sabe cuánto cuesta cada gramo.',
+    );
+  }
+  return (costoPorPiezaCentavos * ESCALA + rendimiento / 2n) / rendimiento;
+}
+
+/**
+ * Mueve la existencia de un insumo en un almacén, CON GUARDA.
+ *
+ * `delta` va firmado y con hasta cuatro decimales. La guarda `cantidad + delta >= 0` está en
+ * el mismo `update`: leer primero y decidir después deja una ventana en la que otra venta se
+ * lleva lo que se iba a abrir. Si el almacén no tiene fila todavía —la cabina de un salón
+ * que nunca abrió nada—, nace en cero antes de sumar.
+ */
+export async function moverExistencia(
+  ctx: ContextoComando<Transaccion>,
+  movimiento: {
+    readonly almacenId: string;
+    readonly insumoId: string;
+    readonly delta: string;
+    /** Qué se dice cuando no alcanza. */
+    readonly sinExistencia: string;
+    /** Lo que se le suma al fallo para que la pantalla diga DE QUÉ producto no alcanzó. */
+    readonly detallesDelFallo?: DetallesError;
+  },
+): Promise<void> {
+  const { organizacionId } = ctx.ambito;
+  await ctx.paso('existencia_en_cero', () =>
+    sql`
+      insert into existencias (organizacion_id, almacen_id, insumo_id, cantidad)
+      values (${organizacionId}, ${movimiento.almacenId}, ${movimiento.insumoId}, 0)
+      on conflict (almacen_id, insumo_id) do nothing
+    `.execute(ctx.tx),
+  );
+  const resultado = await ctx.paso('mover_existencia', () =>
+    sql<{ cantidad: string }>`
+      update existencias
+         set cantidad = cantidad + ${movimiento.delta}, actualizado_en = now()
+       where organizacion_id = ${organizacionId}
+         and almacen_id = ${movimiento.almacenId}
+         and insumo_id = ${movimiento.insumoId}
+         and cantidad + ${movimiento.delta} >= 0
+      returning cantidad
+    `.execute(ctx.tx),
+  );
+  if (resultado.rows.length !== 1) {
+    throw new ErrorDominio('STOCK_INSUFICIENTE', movimiento.sinExistencia, {
+      insumoId: movimiento.insumoId,
+      ...movimiento.detallesDelFallo,
+    });
+  }
+}
