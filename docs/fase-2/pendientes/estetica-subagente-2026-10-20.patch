+import { describe, expect, it } from 'vitest';
+
+import { transaccionGrabadora } from '../pruebas/grabadora.ts';
+import { contextoFalso, crearBaseFalsa, type Fila } from '../restaurante/pruebas/base-falsa.ts';
+import { ambitoDe, ORG } from '../restaurante/pruebas/sala.ts';
+import { consumosDeLaFormula } from './consumo-de-formula.ts';
+
+/**
+ * F-154 · «Una captura, tres efectos»: el consumo de cabina sale de la fórmula.
+ *
+ * `agenda.cerrar_servicio` descontaba sólo lo que le DECÍAN, y la pantalla nunca decía nada:
+ * el tubo que se fue en la cabeza de Mariana seguía en la cabina. Ahora lo que se descuenta es
+ * lo que la última fórmula de ESE servicio tiene ligado a un producto de cabina.
+ */
+
+const AHORA = new Date('2026-09-19T18:30:00.000Z');
+const SERVICIO = 'a1111111-1111-4111-8111-111111111111';
+const OTRO_SERVICIO = 'a2222222-2222-4222-8222-222222222222';
+const TINTE = 'b1111111-1111-4111-8111-111111111111';
+const OXIDANTE = 'b2222222-2222-4222-8222-222222222222';
+
+const formula = (componentes: readonly unknown[], extra: Fila = {}): Fila => ({
+  organizacion_id: ORG,
+  cita_servicio_id: SERVICIO,
+  formula: { mezclado: 160, usado: 150, componentes },
+  aplicada_en: new Date('2026-09-19T17:00:00.000Z'),
+  created_at: new Date('2026-09-19T17:00:00.000Z'),
+  ...extra,
+});
+
+async function consumos(filas: readonly Fila[], servicio = SERVICIO) {
+  const base = crearBaseFalsa({ formulas_aplicadas: filas });
+  const { ctx } = contextoFalso(base.tx, ambitoDe('mesero'), AHORA);
+  return consumosDeLaFormula(ctx, servicio);
+}
+
+describe('el consumo que sale de la fórmula', () => {
+  it('SÓLO LO LIGADO a un producto de cabina: lo escrito a mano es expediente, no inventario', async () => {
+    const salida = await consumos([
+      formula([
+        { nombre: '6.0', cantidad: 70, unidad: 'g', productoId: TINTE },
+        { nombre: 'ox 20 vol', cantidad: 90, unidad: 'ml' },
+      ]),
+    ]);
+
+    expect(salida).toEqual([{ productoId: TINTE, cantidadBase: '70.0000' }]);
+  });
+
+  it('LO DE UN MISMO PRODUCTO SE SUMA, a cuatro decimales exactos', async () => {
+    // 0.1 + 0.2 no son 0.3 en coma flotante; aquí sí: se pasa por enteros escalados.
+    const salida = await consumos([
+      formula([
+        { nombre: 'raíz', cantidad: 0.1, unidad: 'g', productoId: TINTE },
+        { nombre: 'medios', cantidad: 0.2, unidad: 'g', productoId: TINTE },
+        { nombre: 'ox', cantidad: 62.5, unidad: 'ml', productoId: OXIDANTE },
+      ]),
+    ]);
+
+    expect(salida).toEqual([
+      { productoId: TINTE, cantidadBase: '0.3000' },
+      { productoId: OXIDANTE, cantidadBase: '62.5000' },
+    ]);
+  });
+
+  it('LA ÚLTIMA FÓRMULA MANDA: guardar otra para corregir no gasta el material dos veces', async () => {
+    const salida = await consumos([
+      formula([{ nombre: '6.0', cantidad: 60, unidad: 'g', productoId: TINTE }]),
+      formula([{ nombre: '6.0', cantidad: 70, unidad: 'g', productoId: TINTE }], {
+        aplicada_en: new Date('2026-09-19T17:30:00.000Z'),
+        created_at: new Date('2026-09-19T17:30:00.000Z'),
+      }),
+    ]);
+
+    expect(salida).toEqual([{ productoId: TINTE, cantidadBase: '70.0000' }]);
+  });
+
+  it('LA FÓRMULA DE OTRO SERVICIO no es de éste', async () => {
+    const salida = await consumos([
+      formula([{ nombre: '6.0', cantidad: 70, unidad: 'g', productoId: TINTE }], {
+        cita_servicio_id: OTRO_SERVICIO,
+      }),
+    ]);
+
+    expect(salida).toEqual([]);
+  });
+
+  it('SIN FÓRMULA no hay consumo: el servicio se cierra igual y el corte lo confiesa', async () => {
+    expect(await consumos([])).toEqual([]);
+  });
+
+  it('un componente sin cantidad, en cero o con una liga vacía no gasta nada', async () => {
+    const salida = await consumos([
+      formula([
+        { nombre: 'a', cantidad: 0, unidad: 'g', productoId: TINTE },
+        { nombre: 'b', cantidad: -5, unidad: 'g', productoId: TINTE },
+        { nombre: 'c', cantidad: 'mucho', unidad: 'g', productoId: TINTE },
+        { nombre: 'd', cantidad: 30, unidad: 'g', productoId: '' },
+        { nombre: 'e', cantidad: 30, unidad: 'g', productoId: 42 },
+        // Lo que un jsonb no puede guardar pero un objeto sí: no revienta la conversión a enteros.
+        { nombre: 'f', cantidad: Number.NaN, unidad: 'g', productoId: TINTE },
+        { nombre: 'g', cantidad: Number.POSITIVE_INFINITY, unidad: 'g', productoId: TINTE },
+        'basura',
+        null,
+      ]),
+    ]);
+
+    expect(salida).toEqual([]);
+  });
+
+  it('una fórmula sin componentes, o con otra forma, no gasta nada ni rompe el cierre', async () => {
+    expect(await consumos([formula([])])).toEqual([]);
+    expect(await consumos([{ ...formula([]), formula: { mezclado: 60 } }])).toEqual([]);
+    expect(
+      await consumos([{ ...formula([]), formula: { componentes: 'no es una lista' } }]),
+    ).toEqual([]);
+  });
+
+  it('el jsonb llega como texto en el doble de las pruebas: se lee igual', async () => {
+    const texto = JSON.stringify({
+      componentes: [{ nombre: '6.0', cantidad: 70, unidad: 'g', productoId: TINTE }],
+    });
+
+    const salida = await consumos([{ ...formula([]), formula: texto }]);
+
+    expect(salida).toEqual([{ productoId: TINTE, cantidadBase: '70.0000' }]);
+  });
+
+  it('UNA FÓRMULA CORRUPTA se dice: cerrar sin descontar «como si nada» esconde un dato roto', async () => {
+    await expect(consumos([{ ...formula([]), formula: '{no es json' }])).rejects.toThrow();
+  });
+
+  it('lee de la organización de la sesión y de ninguna otra', async () => {
+    const salida = await consumos([
+      formula([{ nombre: '6.0', cantidad: 70, unidad: 'g', productoId: TINTE }], {
+        organizacion_id: '99999999-9999-4999-8999-999999999999',
+      }),
+    ]);
+
+    expect(salida).toEqual([]);
+  });
+});
+
+describe('lo que la lectura pide a la base', () => {
+  /**
+   * La base falsa sólo conoce UN `orderBy` —el último pisa al anterior— y no corta con `limit`, así
+   * que el orden y el tope se afirman sobre el SQL COMPILADO: la más reciente, con su desempate, y
+   * una sola; de este negocio y de ese servicio.
+   */
+  it('LA ÚLTIMA fórmula de ESE servicio, de ESTE negocio, y sólo una', async () => {
+    const { tx, conexion } = transaccionGrabadora([[]]);
+    const { ctx } = contextoFalso(tx, ambitoDe('mesero'), AHORA);
+
+    await consumosDeLaFormula(ctx, SERVICIO);
+
+    const [consulta] = conexion.consultas;
+    expect(consulta?.sql).toMatch(/from "formulas_aplicadas"/);
+    expect(consulta?.sql).toMatch(/"organizacion_id" = \$1 and "cita_servicio_id" = \$2/);
+    expect(consulta?.sql).toMatch(/order by "aplicada_en" desc, "created_at" desc limit \$3/);
+    expect(consulta?.parameters).toEqual([ORG, SERVICIO, 1]);
+    expect(conexion.consultas).toHaveLength(1);
+  });
+});
+
+describe('una fórmula que no es lo que se esperaba no tira el cierre', () => {
+  it('un jsonb nulo, o el texto «null», no gasta nada', async () => {
+    expect(await consumos([{ ...formula([]), formula: null }])).toEqual([]);
+    expect(await consumos([{ ...formula([]), formula: 'null' }])).toEqual([]);
+  });
+
+  it('un jsonb que es un número o un texto suelto tampoco', async () => {
+    expect(await consumos([{ ...formula([]), formula: 5 }])).toEqual([]);
+    expect(await consumos([{ ...formula([]), formula: '"hola"' }])).toEqual([]);
+  });
+});
