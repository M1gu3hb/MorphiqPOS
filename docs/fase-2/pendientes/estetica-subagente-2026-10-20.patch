+    const base = baseDeLaWalkIn();
+    const { ctx } = contextoFalso(base.tx, ambitoDe('cajero'), AHORA);
+
+    const salida = await agendarWalkIn.ejecutar(ctx, {
+      servicios: [{ servicioId: CORTE, profesionalId: DANY }],
+    });
+
+    expect(salida.servicios).toHaveLength(1);
+    expect(base.campo('citas', 'origen')).toBe('walk_in');
+    expect(base.campo('citas', 'estado')).toBe('agendada');
+    expect(base.campo('citas', 'cliente_id')).toBeNull();
+    // La hora de la cita es la del reloj del servidor: la del dispositivo no se pide.
+    expect((base.campo('citas', 'agendada_para') as Date).toISOString()).toBe(AHORA.toISOString());
+    expect(salida.servicios[0]?.inicio).toBe(AHORA.toISOString());
+  });
+
+  it('con clienta, la cita es de ella; el precio lo pone el servidor', async () => {
+    const base = baseDeLaWalkIn();
+    const { ctx } = contextoFalso(base.tx, ambitoDe('gerente'), AHORA);
+
+    const salida = await agendarWalkIn.ejecutar(ctx, {
+      clienteId: CLIENTA,
+      servicios: [{ servicioId: CORTE, profesionalId: KARLA }],
+    });
+
+    expect(base.campo('citas', 'cliente_id')).toBe(CLIENTA);
+    expect(salida.servicios[0]?.precioCentavos).toBe('25000');
+  });
+});
+
+describe('agenda.walk_in · la estilista sólo en lo suyo', () => {
+  it('LA ESTILISTA LA TOMA EN SU COLUMNA', async () => {
+    const base = baseDeLaWalkIn();
+    const { ctx } = contextoFalso(base.tx, ambitoDe('mesero'), AHORA);
+
+    const salida = await agendarWalkIn.ejecutar(ctx, {
+      servicios: [{ servicioId: CORTE, profesionalId: KARLA }],
+    });
+
+    expect(salida.servicios[0]?.profesionalId).toBe(KARLA);
+    expect(base.filas('citas')).toHaveLength(1);
+  });
+
+  it('NO LA PONE EN LA COLUMNA DE OTRA: se niega y no se escribe nada', async () => {
+    const base = baseDeLaWalkIn();
+    const { ctx } = contextoFalso(base.tx, ambitoDe('mesero'), AHORA);
+
+    expect(
+      await codigoDe(() =>
+        agendarWalkIn.ejecutar(ctx, { servicios: [{ servicioId: CORTE, profesionalId: DANY }] }),
+      ),
+    ).toBe('PUENTE_SIN_PERMISO');
+    expect(base.filas('citas')).toHaveLength(0);
+    expect(base.filas('cita_servicios')).toHaveLength(0);
+  });
+
+  it('TAMPOCO AGENDANDO: `agenda.agendar_cita` le niega la columna de otra, con una cita normal', async () => {
+    const base = baseDeLaWalkIn();
+    const { ctx } = contextoFalso(base.tx, ambitoDe('mesero'), AHORA);
+
+    expect(
+      await codigoDe(() =>
+        agendarCita.ejecutar(ctx, {
+          origen: 'mostrador',
+          inicio: '2026-09-17T10:00:00.000Z',
+          servicios: [{ servicioId: CORTE, profesionalId: DANY }],
+        }),
+      ),
+    ).toBe('PUENTE_SIN_PERMISO');
+    expect(base.filas('citas')).toHaveLength(0);
+  });
+
+  it('UNA CITA CON DOS SERVICIOS, UNO DE ELLOS DE OTRA, tampoco entra', async () => {
+    const base = baseDeLaWalkIn();
+    const { ctx } = contextoFalso(base.tx, ambitoDe('mesero'), AHORA);
+
+    expect(
+      await codigoDe(() =>
+        agendarWalkIn.ejecutar(ctx, {
+          servicios: [
+            { servicioId: CORTE, profesionalId: KARLA },
+            { servicioId: CORTE, profesionalId: DANY },
+          ],
+        }),
+      ),
+    ).toBe('PUENTE_SIN_PERMISO');
+    expect(base.filas('citas')).toHaveLength(0);
+  });
+
+  it('sin una profesional ligada a su empleo no es dueña de ninguna columna', async () => {
+    const delSalon = salon();
+    const sinLiga: TablasFalsas = {
+      ...delSalon,
+      // Las dos, de otro empleo: ninguna es de quien entra.
+      profesionales: (delSalon['profesionales'] ?? []).map((p) => ({
+        ...p,
+        empleo_id: OTRO_EMPLEO,
+      })),
+    };
+    const base = crearBaseFalsa(sinLiga, { filasCrudas: [{ siguiente: 7n }] });
+    const { ctx } = contextoFalso(base.tx, ambitoDe('mesero'), AHORA);
+
+    expect(
+      await codigoDe(() =>
+        agendarWalkIn.ejecutar(ctx, { servicios: [{ servicioId: CORTE, profesionalId: KARLA }] }),
+      ),
+    ).toBe('PUENTE_SIN_PERMISO');
+    expect(base.filas('citas')).toHaveLength(0);
+  });
+
+  it('la recepción, en cambio, la pone con quien quiera: la guarda es de la estilista', async () => {
+    const base = baseDeLaWalkIn();
+    const { ctx } = contextoFalso(base.tx, ambitoDe('cajero'), AHORA);
+
+    const salida = await agendarWalkIn.ejecutar(ctx, {
+      servicios: [{ servicioId: CORTE, profesionalId: DANY }],
+    });
+
+    expect(salida.servicios[0]?.profesionalId).toBe(DANY);
+  });
+
+  it('NO LA TOMA CON UNA CLIENTA QUE NO ATIENDE: ni se lee la clienta ni se escribe la cita', async () => {
+    // Su profesional (dos veces: la columna y la clienta) y ningún servicio suyo con ella.
+    const { tx, conexion } = transaccionGrabadora([[{ id: KARLA }], [{ id: KARLA }], []]);
+    const { ctx } = contextoFalso(tx, ambitoDe('mesero'), AHORA);
+
+    expect(
+      await codigoDe(() =>
+        agendarWalkIn.ejecutar(ctx, {
+          clienteId: CLIENTA,
+          servicios: [{ servicioId: CORTE, profesionalId: KARLA }],
+        }),
+      ),
+    ).toBe('PUENTE_SIN_PERMISO');
+    expect(conexion.consultas.some((c) => c.sql.includes('insert into'))).toBe(false);
+    expect(conexion.consultas.some((c) => c.sql.includes('from "clientes"'))).toBe(false);
+  });
+});
