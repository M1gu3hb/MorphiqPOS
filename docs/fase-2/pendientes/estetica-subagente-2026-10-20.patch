+/**
+ * LO QUE EL DÍA DEL SALÓN NECESITA DEL SERVIDOR y las pantallas no ponen a mano
+ * (`dia-completo-estetica.spec.ts`): el anticipo, la lista de espera, la hoja del corte y la
+ * negativa de quien no debe ver lo de otra. Todo por la API con la sesión de la pestaña que lo
+ * pide: lo que se prueba EN pantalla se opera EN pantalla; esto es lo que no tiene pantalla,
+ * o lo que se lee para exigirlo contra el servidor.
+ */
+
+type Respuesta = Awaited<ReturnType<Page['request']['post']>>;
+
+async function datosDe<T>(respuesta: Respuesta, que: string): Promise<T> {
+  expect(respuesta.status(), `${que}: ${(await respuesta.text()).slice(0, 300)}`).toBe(200);
+  return ((await respuesta.json()) as { readonly datos: T }).datos;
+}
+
+/** Una escritura o lectura de comando, con la sesión de esa pestaña, que tiene que ser 200. */
+export async function ordenar<T>(
+  page: Page,
+  ruta: string,
+  entrada: unknown,
+  que: string,
+): Promise<T> {
+  return datosDe<T>(
+    await page.request.post(ruta, { headers: cabecerasDeEscrituraDePrueba(), data: entrada }),
+    que,
+  );
+}
+
+/**
+ * `anticipo.recibir`: el anticipo de una cita. No tiene pantalla —`04-INTERFAZ §4.3.2` sólo
+ * dice «¿pedir anticipo?» en el aviso de quien ya faltó dos veces—, así que entra por su ruta,
+ * con la sesión de la recepción y en la terminal con la caja abierta si es en efectivo.
+ */
+export async function recibirAnticipo(
+  page: Page,
+  citaId: string,
+  montoCentavos: number,
+  metodo: 'efectivo' | 'tarjeta' | 'transferencia',
+): Promise<string> {
+  const { anticipoId } = await ordenar<{ readonly anticipoId: string }>(
+    page,
+    '/api/anticipos',
+    { citaId, montoCentavos, metodo },
+    `anticipo de ${String(montoCentavos)} centavos en ${metodo}`,
+  );
+  return anticipoId;
+}
+
+/** Los anticipos del día como los cuenta el CORTE (`extras.anticipos`), en centavos. */
+export interface AnticiposDelCorte {
+  readonly cobrados: bigint;
+  readonly aplicados: bigint;
+  readonly retenidos: bigint;
+  readonly vivos: bigint;
+  readonly citasConAnticipoVivo: number;
+}
+
+export async function anticiposDelCorte(
+  page: Page,
+  sesionCajaId: string,
+): Promise<AnticiposDelCorte> {
+  const hoja = await ordenar<{
+    readonly extras?: {
+      readonly anticipos?: {
+        readonly cobradosCentavos?: string;
+        readonly aplicadosCentavos?: string;
+        readonly retenidosCentavos?: string;
+        readonly vivosCentavos?: string;
+        readonly vivos?: number;
+      };
+    };
+  }>(page, '/api/caja/hoja-del-corte', { sesionCajaId }, 'caja.hoja_del_corte');
+  const a = hoja.extras?.anticipos;
+  return {
+    cobrados: BigInt(a?.cobradosCentavos ?? '0'),
+    aplicados: BigInt(a?.aplicadosCentavos ?? '0'),
+    retenidos: BigInt(a?.retenidosCentavos ?? '0'),
+    vivos: BigInt(a?.vivosCentavos ?? '0'),
+    citasConAnticipoVivo: a?.vivos ?? 0,
+  };
+}
+
+/** `lista_espera_citas.anotar`: alguien que espera un lugar, con la ventana que le sirve. */
+export async function anotarEnEspera(
+  page: Page,
+  espera: {
+    readonly clienteId: string;
+    readonly profesionalId: string | null;
+    readonly servicioId: string | null;
+    readonly desde: string;
+    readonly hasta: string;
+  },
+): Promise<string> {
+  const { esperaId } = await ordenar<{ readonly esperaId: string }>(
+    page,
+    '/api/lista-espera',
+    { ...espera, flexibleDeDia: false },
+    'lista_espera_citas.anotar',
+  );
+  return esperaId;
+}
+
+/** `cliente.alta`: la ficha de una clienta, y su id. */
+export async function darDeAltaClienta(
+  page: Page,
+  nombre: string,
+  telefono: string,
+): Promise<string> {
+  const { clienteId } = await ordenar<{ readonly clienteId: string }>(
+    page,
+    '/api/clientes',
+    { nombre, telefono },
+    `alta de ${nombre}`,
+  );
+  return clienteId;
+}
+
+/**
+ * LA NEGATIVA: el servidor TIENE que decir que no, con su regla estable (`PUENTE_SIN_PERMISO`)
+ * y NADA de lo ajeno en el cuerpo —ni el nombre de la clienta, ni su dinero—: una negativa que
+ * filtra lo que niega no niega.
+ *
+ * Es el contrato de hoy, y se exige exacto: la estilista SÍ puede invocar `agenda.dia` o
+ * `expediente.abrir` —el rol está en su lista—, lo que no puede es pedirlos de otra; esa guarda
+ * es de DOMINIO, y un `ErrorDominio` sale de un comando como `REGLA_DE_NEGOCIO` (422) con la
+ * regla en `datos.regla` (`comando.ts`), no como `SIN_PERMISO` (403), que es el de un rol que ni
+ * siquiera puede invocar el comando.
+ */
+export async function exigirNegativa(
+  page: Page,
+  ruta: string,
+  entrada: unknown,
+  que: string,
+  loAjeno: readonly string[] = [],
+): Promise<void> {
+  const respuesta = await page.request.post(ruta, {
+    headers: cabecerasDeEscrituraDePrueba(),
+    data: entrada,
+  });
+  const cuerpo = await respuesta.text();
+  expect(respuesta.status(), `${que}: debía negarse y contestó ${cuerpo.slice(0, 200)}`).toBe(422);
+  const dicho = JSON.parse(cuerpo) as {
+    readonly ok?: boolean;
+    readonly error?: {
+      readonly codigo?: string;
+      readonly datos?: { readonly regla?: string };
+    };
+  };
+  expect(dicho.ok, `${que}: la negativa dice que salió bien.`).toBe(false);
+  expect(dicho.error?.codigo, `${que}: no es una regla de negocio.`).toBe('REGLA_DE_NEGOCIO');
+  expect(dicho.error?.datos?.regla, `${que}: la negativa no trae la regla estable.`).toBe(
+    'PUENTE_SIN_PERMISO',
+  );
+  for (const ajeno of loAjeno) {
+    expect(cuerpo, `${que}: la negativa dejó ver «${ajeno}».`).not.toContain(ajeno);
+  }
+}
+
+/**
+ * ¿ESTÁ ESA ENTRADA EN SU MENÚ? Se mira, y el menú queda COMO ESTABA.
+ *
+ * `menuLateral` ABRE el cajón cuando el aparato es un teléfono, y un cajón abierto deja la
+ * hamburguesa debajo de su velo: el `irPorElMenu` que sigue daba clic en el velo y se quedaba
+ * veinte segundos reintentando. En la tableta la barra fija no se abre ni se cierra y esto no
+ * hace nada más. La afirmación es SUAVE —dice que una pantalla no tiene la entrada, y eso no
+ * mueve el día—: se anota y la prueba sigue, pero la prueba falla al final si no estaba.
+ */
+export async function exigirEnElMenu(page: Page, etiqueta: string, porQue: string): Promise<void> {
+  const menu = await menuLateral(page);
+  await expect.soft(entradaDeMenu(menu, etiqueta), porQue).toBeVisible();
+  const cerrar = page.getByRole('button', { name: 'Cerrar menú' });
+  if (await cerrar.isVisible()) {
+    await cerrar.click();
+    await expect(cerrar).toBeHidden();
+  }
+}
