+import { esErrorDominio } from '@morphiqpos/contracts';
+import { describe, expect, it } from 'vitest';
+
+import { transaccionGrabadora } from '../pruebas/grabadora.ts';
+import {
+  contextoFalso,
+  crearBaseFalsa,
+  type TablasFalsas,
+} from '../restaurante/pruebas/base-falsa.ts';
+import { ambitoDe, EMPLEO, ORG } from '../restaurante/pruebas/sala.ts';
+import { agendarCita } from './agenda.ts';
+import { agendarWalkIn } from './reprogramar.ts';
+
+/**
+ * F-413 · La walk-in: una cita que nació hace treinta segundos, tomada por quien la tiene
+ * sentada enfrente.
+ *
+ * ── Lo que estas pruebas defienden ───────────────────────────────────────
+ * Que la estilista PUEDA tomarla (`05-DATOS §5`: «todos»; el botón de «Mi día» no tenía
+ * comando), y que sólo pueda tomarla en SU columna y con SUS clientas: la walk-in pasa por
+ * `agenda.agendar_cita`, que admitía el rol de la profesional sin mirar a quién se le ponía
+ * la cita. Y que la hora la ponga el servidor, no el reloj del dispositivo.
+ */
+
+const AHORA = new Date('2026-09-16T16:40:00.000Z');
+const KARLA = 'a1000000-0000-4000-8000-000000000001';
+const DANY = 'a1000000-0000-4000-8000-000000000002';
+const CORTE = 'c1000000-0000-4000-8000-000000000001';
+const CLIENTA = 'cc000000-0000-4000-8000-000000000001';
+const OTRO_EMPLEO = '55555555-5555-4555-8555-555555555556';
+
+function salon(): TablasFalsas {
+  return {
+    // Karla es la estilista que entra (su empleo es el de la sesión); Dany es de otro empleo.
+    profesionales: [
+      { id: KARLA, organizacion_id: ORG, nombre_corto: 'Karla', activo: true, empleo_id: EMPLEO },
+      {
+        id: DANY,
+        organizacion_id: ORG,
+        nombre_corto: 'Dany',
+        activo: true,
+        empleo_id: OTRO_EMPLEO,
+      },
+    ],
+    servicios: [
+      {
+        producto_id: CORTE,
+        organizacion_id: ORG,
+        duracion_activa_1_min: 30,
+        duracion_pasiva_min: 0,
+        duracion_activa_2_min: 0,
+        duracion_cierre_min: 5,
+      },
+    ],
+    servicios_profesional: [
+      {
+        servicio_id: CORTE,
+        profesional_id: KARLA,
+        organizacion_id: ORG,
+        precio_centavos: 25_000n,
+        factor_duracion_bp: 10_000,
+      },
+      {
+        servicio_id: CORTE,
+        profesional_id: DANY,
+        organizacion_id: ORG,
+        precio_centavos: 20_000n,
+        factor_duracion_bp: 10_000,
+      },
+    ],
+    productos: [
+      { id: CORTE, organizacion_id: ORG, nombre: 'Corte', precio_venta_centavos: 22_000n },
+    ],
+    clientes: [{ id: CLIENTA, organizacion_id: ORG, nombre: 'Sra. Paty' }],
+    citas: [],
+    cita_servicios: [],
+  };
+}
+
+const baseDeLaWalkIn = () =>
+  crearBaseFalsa(salon(), {
+    filasCrudas: [{ siguiente: 7n }],
+    predeterminados: {
+      citas: {
+        cliente_id: null,
+        llego_en: null,
+        inicio_real: null,
+        fin_real: null,
+        orden_id: null,
+        cita_origen_id: null,
+        es_rehacer: false,
+        es_cortesia: false,
+        motivo_cancelacion: null,
+        no_llego_marcado_en: null,
+        no_llego_marcado_por: null,
+        notas: null,
+      },
+      cita_servicios: { cerrado_en: null, orden_linea_id: null },
+    },
+  });
+
+async function codigoDe(fn: () => Promise<unknown>): Promise<string> {
+  try {
+    await fn();
+    return 'NO LANZÓ';
+  } catch (error) {
+    return esErrorDominio(error) ? error.codigo : `INESPERADO: ${String(error)}`;
+  }
+}
