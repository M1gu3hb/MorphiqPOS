+
+import { ErrorApi, invocarComando } from '~/cliente/api';
+
+import { decimalesDe, QUE_PASO_EN_LA_CABINA } from './productos-del-salon.ts';
+
+/**
+ * EL KARDEX DE LA CABINA · lo que entró de cada pieza abierta y lo que gastó cada servicio.
+ *
+ * `inventario.kardex` es de UN almacén, y sin decir cuál lee el PRINCIPAL: el anaquel. El kardex
+ * de la ficha de un producto (`KardexDelProducto`, el del abarrote, que sólo pide el insumo)
+ * enseñaba así el lado del anaquel —«Salió a otro almacén, −1»— y nada de lo que pasa DENTRO de
+ * la cabina: ni los gramos que entraron al abrir la pieza ni el tinte de cada servicio, que es
+ * justo lo que esta pantalla promete («con la apertura a cabina y el consumo de cada servicio»).
+ * La cabina es otro almacén y otra unidad (g, ml): se lee aparte, con su id, y se dice en SU
+ * unidad.
+ */
+
+interface Renglon {
+  readonly movimientoId: string;
+  readonly cuando: string;
+  readonly tipo: string;
+  readonly cantidad: string;
+  readonly saldo: string;
+}
+
+interface Kardex {
+  readonly renglones: readonly Renglon[];
+  readonly hayMas: boolean;
+}
+
+const CUANDO = new Intl.DateTimeFormat('es-MX', {
+  day: 'numeric',
+  month: 'short',
+  hour: '2-digit',
+  minute: '2-digit',
+});
+
+/** Cuántos movimientos se ven de una vez: la ficha viene a buscar lo reciente. */
+const LIMITE = 60;
+
+export interface KardexDeLaCabinaProps {
+  readonly insumoId: string;
+  /** El almacén de cabina de la sucursal (`cabina.existencias`). */
+  readonly almacenId: string;
+  /** La unidad en que se cuenta la cabina: g, ml. */
+  readonly unidad: string;
+}
+
+export function KardexDeLaCabina({ insumoId, almacenId, unidad }: KardexDeLaCabinaProps) {
+  const [kardex, setKardex] = useState<Kardex | null>(null);
+  const [fallo, setFallo] = useState<string | null>(null);
+  const [intento, setIntento] = useState(0);
+
+  useEffect(() => {
+    let vigente = true;
+    const desde = new Date(Date.now() - 90 * 86_400_000).toISOString();
+    invocarComando<Kardex>('/api/inventario/kardex', {
+      insumoId,
+      almacenId,
+      desde,
+      limite: LIMITE,
+      recientes: true,
+    })
+      .then((leido) => {
+        if (vigente) setKardex(leido);
+      })
+      .catch((error: unknown) => {
+        if (vigente) {
+          setFallo(error instanceof ErrorApi ? error.message : 'No se pudo leer el kardex.');
+        }
+      });
+    return () => {
+      vigente = false;
+    };
+  }, [insumoId, almacenId, intento]);
+
+  const columnas: readonly ColumnaDeTabla<Renglon>[] = [
+    {
+      clave: 'cuando',
+      titulo: 'Cuándo',
+      celda: (r) => (
+        <span className="text-texto-sutil tabular-nums">{CUANDO.format(new Date(r.cuando))}</span>
+      ),
+    },
+    {
+      clave: 'que',
+      titulo: 'Qué pasó',
+      celda: (r) => QUE_PASO_EN_LA_CABINA[r.tipo] ?? r.tipo,
+    },
+    {
+      clave: 'cantidad',
+      titulo: 'Movió',
+      numerica: true,
+      celda: (r) => (
+        <Cifra
+          valor={Number(r.cantidad)}
+          unidad={unidad}
+          decimales={decimalesDe(r.cantidad)}
+          conSigno
+          tamano="sm"
+        />
+      ),
+    },
+    {
+      clave: 'saldo',
+      titulo: 'Quedó',
+      numerica: true,
+      celda: (r) => (
+        <Cifra
+          valor={Number(r.saldo)}
