@@ -0,0 +1,32 @@
+/**
+ * SI EL EXPEDIENTE DECLARA UNA ALERGIA DE VERDAD (F-153). Lo puro, sin React y con su prueba
+ * (`alergia-del-expediente.test.ts`).
+ *
+ * El campo es obligatorio «aunque sea ninguna conocida», así que el texto vacío y el «ninguna»
+ * significan lo mismo: no hay bandera. Tratar cualquier texto como alergia pondría el triángulo
+ * en todas las citas, y entonces no avisa de nada.
+ *
+ * La agenda y la cita en curso lo deciden aquí, las dos: una que pinta la bandera y la otra
+ * que no es cómo se llega a la silla sin saberlo. La agenda la leía bien; la cabina —donde se
+ * tocan el frasco y la cabeza— leía `Cliente`, que no sirve las alergias, y nunca la enseñó.
+ */
+
+/** Lo que se contesta cuando se preguntó y no hay: es una respuesta, no una alergia. */
+const SIN_ALERGIA: ReadonlySet<string> = new Set([
+  'ninguna',
+  'ninguna conocida',
+  'no',
+  'no tiene',
+  'sin alergias',
+  '-',
+]);
+
+export function declaraAlergia(texto: string | null | undefined): boolean {
+  const limpio = (texto ?? '').trim().toLowerCase();
+  return limpio !== '' && !SIN_ALERGIA.has(limpio);
+}
+
+/** La alergia que se enseña, tal como se escribió y sin los espacios de los lados; o `null`. */
+export function alergiaDeclarada(texto: string | null | undefined): string | null {
+  return declaraAlergia(texto) ? (texto ?? '').trim() : null;
+}
