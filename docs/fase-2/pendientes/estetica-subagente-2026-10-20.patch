+'use client';
+
+import { useRouter } from 'next/navigation';
+import { useEffect, useRef, useState } from 'react';
+
+import { ErrorApi, consultarPuente, invocarComando } from '~/cliente/api';
+
+import {
+  darDeAltaALaClienta,
+  quienLaAtiende,
+  quienesDanElServicio,
+  serviciosParaLaWalkIn,
+  tomarLaWalkIn,
+  type AsignacionDeLaWalkIn,
+  type PersonaDeLaWalkIn,
+  type ServicioDeLaWalkIn,
+  type WalkInTomada,
+} from './walk-in.ts';
+
+/**
+ * EL ESTADO DE LA HOJA DE LA WALK-IN (F-413), aparte de lo que se pinta: qué se leyó para
+ * ofrecer, qué se eligió y la secuencia de comandos al empezar. Lo puro, y su prueba, están en
+ * `walk-in.ts`; `WalkIn.tsx` sólo lo dibuja.
+ */
+
+interface FilaDeServicio {
+  readonly id?: string;
+  readonly nombre?: string | null;
+}
+
+interface FilaDeProfesional {
+  readonly id: string;
+  readonly nombre_corto: string | null;
+  readonly nombre_completo: string | null;
+  readonly activo: boolean | null;
+}
+
+/** Lo que se necesita para ofrecer: los servicios, quién da cuál y el equipo que se puede ver. */
+export type CatalogoDeLaWalkIn =
+  | { readonly estado: 'leyendo' }
+  | { readonly estado: 'fallo'; readonly mensaje: string }
+  | {
+      readonly estado: 'listo';
+      readonly servicios: readonly ServicioDeLaWalkIn[];
+      readonly asignaciones: readonly AsignacionDeLaWalkIn[];
+      readonly equipo: readonly PersonaDeLaWalkIn[];
+    };
+
+const mensajeDe = (fallo: unknown, porOmision: string): string =>
+  fallo instanceof ErrorApi ? fallo.message : porOmision;
+
+export function useWalkIn(paraQuien: string | null, alCerrar: () => void) {
+  const router = useRouter();
+  const [catalogo, setCatalogo] = useState<CatalogoDeLaWalkIn>({ estado: 'leyendo' });
+  const [intento, setIntento] = useState(0);
+  const [servicioId, setServicioId] = useState<string | null>(null);
+  const [elegida, setElegida] = useState<string | null>(null);
+  const [nombre, setNombre] = useState('');
+  const [telefono, setTelefono] = useState('');
+  const [enviando, setEnviando] = useState(false);
+  const [fallo, setFallo] = useState<string | null>(null);
+  /** Quedó agendada pero no se pudo empezar: se dice y se deja la puerta a la agenda. */
+  const [aMedias, setAMedias] = useState<WalkInTomada | null>(null);
+  /** La ficha que ya se dio de alta en un intento anterior: reintentar no la duplica. */
+  const alta = useRef<{ readonly clave: string; readonly clientaId: string } | null>(null);
+
+  useEffect(() => {
+    const control = new AbortController();
+    const opciones = { signal: control.signal };
+    Promise.all([
+      consultarPuente<FilaDeServicio>('ProductoTerminado', {
+        filtro: { tipo_venta: 'servicio' },
+        limite: 120,
+        ...opciones,
+      }),
+      invocarComando<{ readonly asignaciones: readonly AsignacionDeLaWalkIn[] }>(
+        '/api/servicios/asignaciones',
+        { servicioId: null },
+        opciones,
+      ),
+      consultarPuente<FilaDeProfesional>('Profesional', { limite: 40, ...opciones }),
+    ])
+      .then(([filasDeServicio, asignadas, filasDeEquipo]) => {
+        if (control.signal.aborted) return;
+        setCatalogo({
+          estado: 'listo',
+          servicios: filasDeServicio.flatMap((f) =>
+            f.id === undefined ? [] : [{ id: f.id, nombre: f.nombre ?? 'Servicio' }],
+          ),
+          asignaciones: asignadas.asignaciones,
+          equipo: filasDeEquipo
+            .filter((f) => f.activo !== false)
+            .map((f) => ({
+              id: f.id,
+              nombre: f.nombre_corto ?? f.nombre_completo ?? 'Sin nombre',
+            })),
+        });
+      })
+      .catch((error: unknown) => {
+        if (control.signal.aborted) return;
+        setCatalogo({ estado: 'fallo', mensaje: mensajeDe(error, 'No se pudo leer el catálogo.') });
+      });
+    return () => {
+      control.abort();
+    };
+  }, [intento]);
+
+  const listo = catalogo.estado === 'listo' ? catalogo : null;
+  // La estilista sólo se ve a sí misma (el servidor recorta el equipo): la hoja es SUYA.
+  const fija = listo?.equipo.length === 1 ? (listo.equipo[0]?.id ?? null) : null;
+  const servicios =
+    listo === null ? [] : serviciosParaLaWalkIn(listo.servicios, listo.asignaciones, fija);
+  const opciones =
+    listo === null || servicioId === null
+      ? []
+      : quienesDanElServicio(servicioId, listo.asignaciones, listo.equipo, fija);
+  const quien = quienLaAtiende(opciones, elegida, paraQuien);
+
+  async function empezar(): Promise<void> {
+    if (servicioId === null || quien === null) return;
+    setEnviando(true);
+    setFallo(null);
+    try {
+      const clave = `${nombre.trim()}|${telefono.trim()}`;
+      let clientaId = alta.current?.clave === clave ? alta.current.clientaId : null;
+      if (clientaId === null) {
+        clientaId = await darDeAltaALaClienta(invocarComando, nombre, telefono);
+        alta.current = clientaId === null ? null : { clave, clientaId };
+      }
+      const tomada = await tomarLaWalkIn(invocarComando, {
+        clientaId,
+        servicioId,
+        profesionalId: quien,
+      });
+      if (tomada.empezada) {
+        alCerrar();
+        router.push(`/estetica-salon/cita-en-curso?cita=${encodeURIComponent(tomada.citaId)}`);
+      } else {
+        setAMedias(tomada);
+      }
+    } catch (error: unknown) {
+      setFallo(mensajeDe(error, 'No se pudo tomar la walk-in.'));
+    } finally {
+      setEnviando(false);
+    }
+  }
+
+  return {
+    catalogo,
+    servicios,
+    opciones,
+    fija,
+    servicioId,
+    quien,
+    nombre,
+    telefono,
+    enviando,
+    fallo,
+    aMedias,
+    puedeEmpezar: !enviando && servicioId !== null && quien !== null && aMedias === null,
+    elegirServicio: (id: string): void => {
+      setServicioId(id);
+      setElegida(null);
+    },
+    elegirPersona: setElegida,
+    setNombre,
+    setTelefono,
+    volverALeer: (): void => {
+      setCatalogo({ estado: 'leyendo' });
+      setIntento((previo) => previo + 1);
+    },
+    irALaAgenda: (): void => {
+      alCerrar();
+      router.push('/estetica-salon/agenda-del-dia');
+    },
+    empezar: (): void => {
+      void empezar();
+    },
+  };
+}
diff --git a/apps/web/src/estetica-salon/walk-in.test.ts b/apps/web/src/estetica-salon/walk-in.test.ts
new file mode 100644
index 0000000..bccb09e
--- /dev/null
+++ b/apps/web/src/estetica-salon/walk-in.test.ts
@@ -0,0 +1,171 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  darDeAltaALaClienta,
+  quienLaAtiende,
+  quienesDanElServicio,
+  serviciosParaLaWalkIn,
+  tomarLaWalkIn,
+  type AsignacionDeLaWalkIn,
+  type InvocarComando,
+  type PersonaDeLaWalkIn,
+  type ServicioDeLaWalkIn,
+} from './walk-in.ts';
+
+/**
+ * F-413 · La walk-in en dos toques. Lo que se ofrece, con quién, y la secuencia de comandos
+ * que la convierte en una clienta sentada: agendar AHORA y empezar.
+ */
+
+const CORTE: ServicioDeLaWalkIn = { id: 'corte', nombre: 'Corte de dama' };
+const TINTE: ServicioDeLaWalkIn = { id: 'tinte', nombre: 'Tinte' };
+const SIN_DUENA: ServicioDeLaWalkIn = { id: 'sin-duena', nombre: 'Servicio que nadie da' };
+const KARLA: PersonaDeLaWalkIn = { id: 'karla', nombre: 'Karla' };
+const DANY: PersonaDeLaWalkIn = { id: 'dany', nombre: 'Dany' };
+const ASIGNACIONES: readonly AsignacionDeLaWalkIn[] = [
+  { servicioId: 'corte', profesionalId: 'karla' },
+  { servicioId: 'corte', profesionalId: 'dany' },
+  { servicioId: 'tinte', profesionalId: 'dany' },
+];
+
+describe('qué servicios se ofrecen', () => {
+  it('los que ALGUIEN da: uno que nadie da sería una cita que el servidor rechaza', () => {
+    const ofrecidos = serviciosParaLaWalkIn([CORTE, TINTE, SIN_DUENA], ASIGNACIONES, null);
+    expect(ofrecidos.map((s) => s.id)).toEqual(['corte', 'tinte']);
+  });
+
+  it('a la estilista, SÓLO los que ELLA da', () => {
+    expect(serviciosParaLaWalkIn([CORTE, TINTE], ASIGNACIONES, 'karla').map((s) => s.id)).toEqual([
+      'corte',
+    ]);
+    expect(serviciosParaLaWalkIn([CORTE, TINTE], ASIGNACIONES, 'dany').map((s) => s.id)).toEqual([
+      'corte',
+      'tinte',
+    ]);
+  });
+
+  it('sin asignaciones leídas no se ofrece nada, en vez de ofrecerlo todo', () => {
+    expect(serviciosParaLaWalkIn([CORTE, TINTE], [], null)).toEqual([]);
+  });
+});
+
+describe('con quién', () => {
+  it('quienes dan el servicio, en el orden del equipo', () => {
+    expect(quienesDanElServicio('corte', ASIGNACIONES, [DANY, KARLA], null)).toEqual([DANY, KARLA]);
+    expect(quienesDanElServicio('tinte', ASIGNACIONES, [KARLA, DANY], null)).toEqual([DANY]);
+  });
+
+  it('con una fija, sólo ella y sólo si lo da', () => {
+    expect(quienesDanElServicio('corte', ASIGNACIONES, [KARLA, DANY], 'karla')).toEqual([KARLA]);
+    expect(quienesDanElServicio('tinte', ASIGNACIONES, [KARLA, DANY], 'karla')).toEqual([]);
+  });
+
+  it('la ÚNICA que puede, sin preguntar: el segundo toque es empezar', () => {
+    expect(quienLaAtiende([KARLA], null, null)).toBe('karla');
+    // Aunque se hubiera elegido otra antes: ya no es una opción.
+    expect(quienLaAtiende([KARLA], 'dany', null)).toBe('karla');
+  });
+
+  it('con varias, la elegida; si no hay elegida, aquella por la que se abrió la hoja', () => {
+    expect(quienLaAtiende([KARLA, DANY], 'dany', 'karla')).toBe('dany');
+    expect(quienLaAtiende([KARLA, DANY], null, 'karla')).toBe('karla');
+  });
+
+  it('una elegida o sugerida que ya no es opción NO cuenta: se pregunta de nuevo', () => {
+    expect(quienLaAtiende([DANY, { id: 'paty', nombre: 'Paty' }], 'karla', 'karla')).toBeNull();
+    expect(quienLaAtiende([], 'karla', 'karla')).toBeNull();
+  });
+});
+
+/** Un `invocarComando` de guion: apunta cada llamada y contesta lo que el guion diga. */
+function guion(respuestas: Readonly<Record<string, unknown>>) {
+  const llamadas: { ruta: string; entrada: unknown }[] = [];
+  const invocar: InvocarComando = async <T>(ruta: string, entrada: unknown): Promise<T> => {
+    llamadas.push({ ruta, entrada });
+    const respuesta = respuestas[ruta];
+    if (respuesta instanceof Error) throw respuesta;
+    return respuesta as T;
+  };
+  return { invocar, llamadas };
+}
+
+describe('dar de alta a la clienta que dijo su nombre', () => {
+  it('sin nombre no se da de alta a nadie: se atiende sin ficha', async () => {
+    const { invocar, llamadas } = guion({});
+    expect(await darDeAltaALaClienta(invocar, '   ', '5512345678')).toBeNull();
+    expect(llamadas).toEqual([]);
+  });
+
+  it('con nombre y sin teléfono, la ficha nace sin teléfono: no se inventa', async () => {
+    const { invocar, llamadas } = guion({ '/api/clientes': { clienteId: 'c1' } });
+    expect(await darDeAltaALaClienta(invocar, ' Ximena Lara ', '  ')).toBe('c1');
+    expect(llamadas).toEqual([
+      { ruta: '/api/clientes', entrada: { nombre: 'Ximena Lara', telefono: null } },
+    ]);
+  });
+
+  it('con teléfono, viaja recortado', async () => {
+    const { invocar, llamadas } = guion({ '/api/clientes': { clienteId: 'c2' } });
+    await darDeAltaALaClienta(invocar, 'Ximena', ' 55 1234 5678 ');
+    expect(llamadas[0]?.entrada).toEqual({ nombre: 'Ximena', telefono: '55 1234 5678' });
+  });
+});
+
+describe('tomar la walk-in', () => {
+  const datos = { clientaId: null, servicioId: 'corte', profesionalId: 'karla' } as const;
+
+  it('AGENDA AHORA y EMPIEZA, en ese orden: la clienta ya está sentada', async () => {
+    const { invocar, llamadas } = guion({
+      '/api/citas/walk-in': { citaId: 'cita-1' },
+      '/api/citas/cita-1/iniciar': { citaId: 'cita-1', estado: 'en_curso' },
+    });
+
+    const tomada = await tomarLaWalkIn(invocar, datos);
+
+    expect(tomada).toEqual({ citaId: 'cita-1', empezada: true, falloAlEmpezar: null });
+    expect(llamadas.map((l) => l.ruta)).toEqual([
+      '/api/citas/walk-in',
+      '/api/citas/cita-1/iniciar',
+    ]);
+    // Ni hora ni precio viajan: la hora la pone el servidor y el precio también.
+    expect(llamadas[0]?.entrada).toEqual({
+      servicios: [{ servicioId: 'corte', profesionalId: 'karla' }],
+    });
+  });
+
+  it('con clienta, la cita es suya', async () => {
+    const { invocar, llamadas } = guion({
+      '/api/citas/walk-in': { citaId: 'cita-2' },
+      '/api/citas/cita-2/iniciar': {},
+    });
+    await tomarLaWalkIn(invocar, { ...datos, clientaId: 'c1' });
+    expect(llamadas[0]?.entrada).toEqual({
+      clienteId: 'c1',
+      servicios: [{ servicioId: 'corte', profesionalId: 'karla' }],
+    });
+  });
+
+  it('si EMPEZAR falla, la cita QUEDÓ agendada y se dice: no desaparece', async () => {
+    const { invocar } = guion({
+      '/api/citas/walk-in': { citaId: 'cita-3' },
+      '/api/citas/cita-3/iniciar': new Error('Esa cita ya no estaba por empezar.'),
+    });
+
+    const tomada = await tomarLaWalkIn(invocar, datos);
+
+    expect(tomada).toEqual({
+      citaId: 'cita-3',
+      empezada: false,
+      falloAlEmpezar: 'Esa cita ya no estaba por empezar.',
+    });
+  });
+
+  it('si AGENDAR falla, no se intenta empezar nada y el fallo sube', async () => {
+    const { invocar, llamadas } = guion({
+      '/api/citas/walk-in': new Error('Esa persona ya tiene a alguien a esa hora.'),
+    });
+
+    await expect(tomarLaWalkIn(invocar, datos)).rejects.toThrow('ya tiene a alguien');
+    expect(llamadas.map((l) => l.ruta)).toEqual(['/api/citas/walk-in']);
+  });
+});
