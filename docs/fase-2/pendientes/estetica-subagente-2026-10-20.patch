@@ -0,0 +1,104 @@
+'use client';
+
+import { useState } from 'react';
+
+import { ErrorApi, invocarComando } from '~/cliente/api';
+
+import { useAnticipoDeLaCita } from './anticipo-de-la-cita.ts';
+import {
+  aplazarHasta,
+  citasSinLlegar,
+  type BloqueConHora,
+  type CitaSinLlegar,
+  type FaltaMarcada,
+  type QuienDecideEnLaAgenda,
+  type ResultadoDelNoLlego,
+} from './sin-llegar.ts';
+
+/**
+ * EL ESTADO DE LA FRANJA DE «SIN LLEGAR» y el de su confirmación (F-412), aparte de lo que se
+ * pinta: `SinLlegar.tsx` es sólo la pantalla, y lo que decide qué se muestra y qué se manda
+ * está aquí, donde cabe entero.
+ */
+
+/** Qué citas se preguntan, a cuál se está decidiendo y qué se contó de la última que se marcó. */
+export function useSinLlegar(
+  bloques: readonly BloqueConHora[],
+  dia: string | null,
+  ahoraMs: number | null,
+  decide: QuienDecideEnLaAgenda,
+  alMarcar: () => void,
+) {
+  /** «Va en camino»: cada cita vuelve a preguntarse al llegar su instante. */
+  const [aplazadas, setAplazadas] = useState<ReadonlyMap<string, number>>(new Map());
+  const [eligiendo, setEligiendo] = useState<CitaSinLlegar | null>(null);
+  const [marcada, setMarcada] = useState<FaltaMarcada | null>(null);
+
+  const sinLlegar =
+    decide.marcaLaFalta && dia !== null && ahoraMs !== null
+      ? citasSinLlegar(bloques, dia, ahoraMs, aplazadas)
+      : [];
+
+  return {
+    sinLlegar,
+    eligiendo,
+    setEligiendo,
+    // Lo que se contó vale para el día en que se marcó: en otro día ya no dice nada.
+    contada: marcada !== null && marcada.dia === dia ? marcada : null,
+    olvidarLoContado: () => {
+      setMarcada(null);
+    },
+    aplazar: (citaId: string): void => {
+      setAplazadas((previas) => new Map(previas).set(citaId, aplazarHasta(Date.now())));
+    },
+    yaSeMarco: (cita: CitaSinLlegar, resultado: ResultadoDelNoLlego): void => {
+      setEligiendo(null);
+      if (dia !== null) setMarcada({ dia, cita, resultado });
+      alMarcar();
+    },
+  };
+}
+
+/**
+ * La confirmación de «no llegó»: el anticipo que hay, lo que se decide sobre él, la nota y el
+ * envío. El comando contesta con lo que quedó hecho, y eso es lo que sube a `alMarcada`.
+ */
+export function useConfirmarLaFalta(
+  cita: CitaSinLlegar,
+  alMarcada: (resultado: ResultadoDelNoLlego) => void,
+) {
+  const { lectura, volverALeer } = useAnticipoDeLaCita(cita.citaId);
+  const [devolver, setDevolver] = useState(false);
+  const [nota, setNota] = useState('');
+  const [enviando, setEnviando] = useState(false);
+  const [fallo, setFallo] = useState<string | null>(null);
+  // Sin un anticipo a la vista no hay nada que devolver, aunque la casilla se hubiera tocado.
+  const devuelve = devolver && lectura.estado === 'con';
+
+  function marcar(): void {
+    setEnviando(true);
+    setFallo(null);
+    invocarComando<ResultadoDelNoLlego>(`/api/citas/${encodeURIComponent(cita.citaId)}/no-llego`, {
+      retieneAnticipo: !devuelve,
+      ...(nota.trim() === '' ? {} : { nota: nota.trim() }),
+    })
+      .then(alMarcada)
+      .catch((error: unknown) => {
+        // Con el mensaje del servidor: «abre la caja para devolver el anticipo» no se adivina.
+        setFallo(error instanceof ErrorApi ? error.message : 'No se pudo marcar la cita.');
+        setEnviando(false);
+      });
+  }
+
+  return {
+    lectura,
+    volverALeer,
+    devolver: devuelve,
+    setDevolver,
+    nota,
+    setNota,
+    enviando,
+    fallo,
+    marcar,
+  };
+}
