+import { beforeAll, describe, expect, it } from 'vitest';
+
+import { exigirOk } from '../pruebas/negocio-real.ts';
+import { conSalon } from './cabina.integracion.ayuda.ts';
+import { sembrarSalonConCabina, type SalonConCabina } from './cabina.integracion.siembra.ts';
+
+/**
+ * F-154 · LA ÚLTIMA FÓRMULA DE ESE SERVICIO MANDA, contra Postgres.
+ *
+ * Corregir una fórmula es guardar otra. Si el cierre sumara las dos, o tomara la primera, la
+ * estilista que se equivocó de 10 g gastaría el tinte dos veces; y la fórmula de OTRO servicio no
+ * es de éste. El doble en memoria sólo conoce un `orderBy`, así que el orden —la más reciente
+ * primero— sólo se ve de verdad en la base.
+ */
+
+let salon: SalonConCabina;
+let s: ReturnType<typeof conSalon>;
+
+beforeAll(async () => {
+  salon = await sembrarSalonConCabina('Salón de las Fórmulas');
+  s = conSalon(salon);
+  // Dos piezas abiertas: 200 g en la cabina, de sobra para lo que se gasta aquí.
+  const abierta = await s.abrir(2);
+  exigirOk(abierta, 'cabina.abrir_producto');
+});
+
+describe('F-154 · de varias fórmulas, gasta la ÚLTIMA y sólo de su servicio', () => {
+  it('guardó 60 g y luego corrigió a 70 g: se gastan 70, no 60 ni 130', async () => {
+    const { citaId, servicioDeLaCita } = await s.citaConServicio('2026-12-03T16:00:00.000Z');
+    exigirOk(await s.capturar(citaId, 60), 'primera fórmula');
+    exigirOk(await s.capturar(citaId, 70), 'fórmula corregida');
+    const antes = await s.existenciaDelTinte(salon.almacenDeCabina);
+
+    const cierre = exigirOk(await s.cerrar(servicioDeLaCita), 'agenda.cerrar_servicio');
+
+    expect(cierre.consumos).toBe(1);
+    expect(antes - (await s.existenciaDelTinte(salon.almacenDeCabina))).toBe(70);
+    const consumos = (await s.movimientosDelTinte()).filter((m) => m.tipo === 'consumo_servicio');
+    expect(consumos.map((m) => Number(m.cantidad))).toEqual([-70]);
+  });
+
+  it('LA FÓRMULA DE OTRA CITA no se gasta en ésta', async () => {
+    const otra = await s.citaConServicio('2026-12-03T18:00:00.000Z');
+    exigirOk(await s.capturar(otra.citaId, 90), 'fórmula de la otra');
+    const esta = await s.citaConServicio('2026-12-03T20:00:00.000Z');
+    const antes = await s.existenciaDelTinte(salon.almacenDeCabina);
+
+    // Esta cita no tiene fórmula: se cierra sin gastar nada, y la de la otra queda intacta.
+    const cierre = exigirOk(await s.cerrar(esta.servicioDeLaCita), 'agenda.cerrar_servicio');
+
+    expect(cierre.consumos).toBe(0);
+    expect(await s.existenciaDelTinte(salon.almacenDeCabina)).toBe(antes);
+  });
+});
