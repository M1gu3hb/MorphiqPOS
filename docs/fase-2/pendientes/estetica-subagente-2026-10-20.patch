+import 'server-only';
+
+import { ErrorDominio } from '@morphiqpos/contracts';
+import { repoCaja, type Transaccion } from '@morphiqpos/data';
+
+import type { ContextoComando } from '../definicion.ts';
+
+/**
+ * F-412 + F-414 · Lo que el no-show ESCRIBE además de cambiar el estado de la cita.
+ *
+ * ── El defecto que esto arregla ───────────────────────────────────────────────────
+ * `agenda.marcar_no_llego` cambiaba el estado, liberaba el hueco y recibía `retieneAnticipo`…
+ * para apuntarlo en la bitácora y nada más. Marcar una cita como que no llegó dejaba:
+ *
+ *   · el ANTICIPO vivo para siempre. La ficha dice que «la penalización es quedarse con un
+ *     anticipo ya cobrado» (`01-FUNCIONES §3.14`) y el corte ya sabe leer `estado =
+ *     'retenido'` —el «ingreso por cancelación» de `02-DINERO-Y-CAJA §6.1`—, pero nadie
+ *     escribía jamás ese estado: el pasivo se quedaba como deuda viva con una clienta que
+ *     perdió su cita, y el salón no reconocía el ingreso que le tocaba;
+ *   · el ANTECEDENTE sin escribir. `no_shows` existe para que «1 falta es humano, 2 en seis
+ *     meses enciende el aviso, 3 activa el anticipo obligatorio» (§3.16), y la ficha de la
+ *     clienta lee de ahí sus faltas: con la tabla vacía, nadie llegaba nunca a la tercera;
+ *   · el valor de lo que se perdió, que es lo que convierte el no-show de sensación en pesos.
+ *
+ * ── Todo en la MISMA transacción ──────────────────────────────────────────────────
+ * Si devolver un anticipo en efectivo no puede sacar el dinero del cajón —no hay caja
+ * abierta—, la cita NO queda marcada: un no-show con el anticipo a medias es peor que el
+ * que no se marcó. Por eso estas funciones lanzan en vez de devolver un fallo.
+ */
+
+type Ctx = ContextoComando<Transaccion>;
+
+export interface AnticipoResuelto {
+  readonly id: string;
+  readonly montoCentavos: bigint;
+  readonly metodo: string;
+  readonly estado: 'retenido' | 'devuelto';
+}
+
+/**
+ * El anticipo vivo de la cita, resuelto como lo decidió quien marcó.
+ *
+ *   · RETENER (lo normal, `§6.1`): el salón se lo queda. El dinero YA estaba —en el cajón
+ *     si fue efectivo, en el banco si no—, así que no se mueve nada: sólo deja de ser un
+ *     pasivo y pasa a ser ingreso por cancelación, en su propio renglón y NO como venta de
+ *     servicio (no hubo servicio, ni comisión).
+ *   · DEVOLVER (decisión de la dueña): el anticipo en efectivo SALE del cajón, y por eso exige
+ *     la caja abierta de esta terminal; con tarjeta o transferencia se regresa por el mismo
+ *     medio, fuera del cajón, y aquí sólo queda dicho.
+ *
+ * Sin anticipo vivo no hace nada y devuelve `null`.
+ */
+export async function resolverAnticipoDelNoShow(
+  ctx: Ctx,
+  citaId: string,
+  retiene: boolean,
+): Promise<AnticipoResuelto | null> {
+  const { organizacionId, terminalId, empleoId } = ctx.ambito;
+
+  // `for update`: dos marcas a la vez no resuelven dos veces el mismo anticipo.
+  const anticipo = await ctx.paso('leer_anticipo_vivo', () =>
+    ctx.tx
+      .selectFrom('anticipos_cita')
+      .select(['id', 'monto_centavos as monto', 'metodo'])
+      .where('organizacion_id', '=', organizacionId)
+      .where('cita_id', '=', citaId)
+      .where('estado', '=', 'vivo')
+      .forUpdate()
+      .executeTakeFirst(),
+  );
+  if (anticipo === undefined) return null;
+
+  if (!retiene && anticipo.metodo === 'efectivo') {
+    if (terminalId === null) {
+      throw new ErrorDominio(
+        'VENTA_SIN_TERMINAL',
+        'Devolver un anticipo en efectivo lo saca de un cajón: hace falta una terminal dada de alta.',
+      );
+    }
+    const sesion = await ctx.paso('cargar_caja', () =>
+      repoCaja.sesionAbiertaDeTerminal(ctx.tx, organizacionId, terminalId),
+    );
+    if (sesion === null) {
+      throw new ErrorDominio(
+        'CAJA_CERRADA',
+        'Abre la caja para devolver el anticipo: era efectivo y sale del cajón. La cita sigue como estaba.',
+      );
+    }
+    // `devolucion` saca efectivo del cajón (el repositorio le pone el signo).
+    await ctx.paso('sacar_del_cajon', () =>
+      repoCaja.registrarMovimiento(ctx.tx, {
+        organizacionId,
+        sesionCajaId: sesion.id,
+        tipo: 'devolucion',
+        montoCentavos: anticipo.monto,
+        referenciaTipo: 'cita',
+        referenciaId: citaId,
+        empleadoId: empleoId,
+        motivo: 'devolución de anticipo: la cita no llegó',
+      }),
+    );
+  }
+
+  const estado = retiene ? 'retenido' : 'devuelto';
+  // Estado y fecha en la MISMA escritura: la 138 exige `resuelto_en` fuera del estado vivo.
+  const tocados = await ctx.paso('resolver_anticipo', () =>
+    ctx.tx
+      .updateTable('anticipos_cita')
+      .set({
+        estado,
+        resuelto_en: ctx.ahora,
+        motivo_resolucion: retiene
+          ? 'no llegó: el salón se queda con el anticipo'
+          : 'no llegó: se devuelve el anticipo',
+      })
+      .where('organizacion_id', '=', organizacionId)
+      .where('id', '=', anticipo.id)
+      .where('estado', '=', 'vivo')
+      .executeTakeFirst(),
+  );
+  if (Number(tocados.numUpdatedRows) !== 1) {
+    throw new ErrorDominio(
+      'CONFIGURACION_CONFLICTO',
+      'Ese anticipo ya no estaba vivo: alguien lo resolvió mientras se marcaba la cita.',
+    );
+  }
+  return { id: anticipo.id, montoCentavos: anticipo.monto, metodo: anticipo.metodo, estado };
+}
+
+export interface AntecedenteDelNoShow {
+  /** Lo que valía la cita: la suma de los precios congelados de sus servicios. */
+  readonly valorPerdidoCentavos: bigint;
+  /** Cuántas veces ha faltado en los últimos seis meses, ésta incluida. */
+  readonly faltasEnSeisMeses: number;
+}
+
+/** Seis meses hacia atrás, en calendario: es la ventana de «2 enciende el aviso» (§3.16). */
+function haceSeisMeses(ahora: Date): Date {
+  const antes = new Date(ahora);
+  antes.setUTCMonth(antes.getUTCMonth() - 6);
+  return antes;
+}
+
+/**
+ * El antecedente de la falta: una fila en `no_shows` con lo que valía la cita, a quién se le
+ * quedó el anticipo y quién la marcó. Es lo que lee la ficha de la clienta.
+ *
+ * Una cita SIN clienta —una walk-in sin ficha— no puede tener antecedente: no hay a quién
+ * dárselo. Se marca igual, y el valor perdido se devuelve para decirlo.
+ */
+export async function escribirAntecedenteDelNoShow(
+  ctx: Ctx,
+  cita: { readonly id: string; readonly clienteId: string | null; readonly agendadaPara: Date },
+  anticipo: AnticipoResuelto | null,
+  nota: string | null,
+): Promise<AntecedenteDelNoShow> {
+  const { organizacionId, empleoId } = ctx.ambito;
+
+  const servicios = await ctx.paso('leer_lo_que_valia', () =>
+    ctx.tx
+      .selectFrom('cita_servicios')
+      .select(['profesional_id as profesionalId', 'precio_centavos as precio'])
+      .where('organizacion_id', '=', organizacionId)
+      .where('cita_id', '=', cita.id)
+      .orderBy('created_at')
+      .execute(),
+  );
+  const valorPerdidoCentavos = servicios.reduce((suma, s) => suma + s.precio, 0n);
+  if (cita.clienteId === null) return { valorPerdidoCentavos, faltasEnSeisMeses: 0 };
+  const clienteId = cita.clienteId;
+
+  await ctx.paso('anotar_antecedente', () =>
+    ctx.tx
+      .insertInto('no_shows')
+      .values({
+        organizacion_id: organizacionId,
+        cliente_id: clienteId,
+        cita_id: cita.id,
+        // El primero que daba: una cita con dos personas se la pierde la que iba primero.
+        profesional_id: servicios[0]?.profesionalId ?? null,
+        // CUÁNDO faltó: a la hora de la cita, no a la de marcarla —se marca con retraso—.
+        ocurrio_en: cita.agendadaPara,
+        valor_perdido_centavos: valorPerdidoCentavos,
+        anticipo_id: anticipo?.id ?? null,
+        anticipo_retenido: anticipo?.estado === 'retenido',
+        marcado_por: empleoId,
+        nota,
+        created_at: ctx.ahora,
+      })
+      .execute(),
+  );
+
+  const faltas = await ctx.paso('contar_faltas', () =>
+    ctx.tx
+      .selectFrom('no_shows')
+      .select('id')
+      .where('organizacion_id', '=', organizacionId)
+      .where('cliente_id', '=', clienteId)
+      .where('ocurrio_en', '>=', haceSeisMeses(ctx.ahora))
+      .execute(),
+  );
+  return { valorPerdidoCentavos, faltasEnSeisMeses: faltas.length };
+}
