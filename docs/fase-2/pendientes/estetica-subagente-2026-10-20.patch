diff --git a/apps/web/src/estetica-salon/lista-de-espera.ts b/apps/web/src/estetica-salon/lista-de-espera.ts
index ff2fb7b..b00d310 100644
--- a/apps/web/src/estetica-salon/lista-de-espera.ts
+++ b/apps/web/src/estetica-salon/lista-de-espera.ts
@@ -48,3 +48,51 @@ export function enlaceDeAviso(espera: EsperaViva): string | null {
   if (numero === null) return null;
   return `https://wa.me/${numero}?text=${encodeURIComponent(mensajeDeAviso(espera))}`;
 }
+
+/**
+ * El hueco que se acaba de liberar —una cita que no llegó—, con lo que hace falta para
+ * decidir a quién le sirve.
+ */
+export interface HuecoLiberado {
+  /** El nombre corto de quien lo daba: así lo dice la espera. */
+  readonly profesional: string;
+  /** Cuándo empezaba, en milisegundos. */
+  readonly inicioMs: number;
+  /** Los servicios que daba, por nombre: una espera de «cualquier servicio» le sirve a todos. */
+  readonly servicios: readonly string[];
+}
+
+/**
+ * A QUIÉN LE SIRVE EL HUECO QUE SE LIBERÓ (F-409: «se ofrece SOLA cuando se libera un hueco»).
+ *
+ * Una espera sirve si las tres cosas que pidió caben: quién —«con quien sea» sirve con
+ * cualquiera—, qué —«cualquier servicio» sirve con cualquiera— y cuándo —el hueco cae dentro
+ * de su ventana, que es un rango y no una hora porque nadie dice «el sábado a las 11:00»—.
+ * Las ya avisadas siguen sirviendo —alguien que dijo «lo pienso» no pierde su lugar— pero van
+ * detrás de las que nadie ha llamado, que es a quien le toca el primer aviso. Dentro de cada
+ * grupo se respeta el orden de llegada, que ya es el del servidor (prioridad y antigüedad).
+ */
+export function esperasParaElHueco(
+  esperas: readonly EsperaViva[],
+  hueco: HuecoLiberado,
+): readonly EsperaViva[] {
+  const sirven = esperas.filter((espera) => {
+    if (espera.profesionalNombre !== null && espera.profesionalNombre !== hueco.profesional) {
+      return false;
+    }
+    if (espera.servicioNombre !== null && !hueco.servicios.includes(espera.servicioNombre)) {
+      return false;
+    }
+    if (espera.desde === null || espera.hasta === null) return true;
+    return (
+      new Date(espera.desde).getTime() <= hueco.inicioMs &&
+      hueco.inicioMs < new Date(espera.hasta).getTime()
+    );
+  });
+  // Sólo entran las que siguen esperando —una que ya se agendó, se canceló o venció no espera—,
+  // y las que nadie ha llamado van primero.
+  return [
+    ...sirven.filter((espera) => espera.estado === 'esperando'),
+    ...sirven.filter((espera) => espera.estado === 'avisada'),
+  ];
+}
