# Variables de entorno de MorphiqPOS.
#
# Copia este archivo a .env y ajústalo. `.env` está en .gitignore: ningún valor
# real entra al repositorio (R31).
#
# Todas se validan con zod al arrancar (F1.0-T12). Si falta una, el proceso NO
# inicia. Nada de valores por defecto silenciosos que aparecen como un fallo raro
# tres pantallas después.

# --- Base de datos -----------------------------------------------------------
# UNA sola variable decide contra qué Postgres corre todo: la aplicación, las
# migraciones y el generador de tipos. Esa es la propiedad que sostiene A-27
# (poder instalarle su propio servidor a un cliente sin internet).
#
# Entorno principal (A-39) — Supabase, proyecto MorphiqPOS wyqmzhliurwyxuyxznpb:
#   Supabase → Project Settings → Database → Connection string → "Session pooler"
#   Sustituye [YOUR-PASSWORD] por la contraseña de la base. Si no la recuerdas,
#   en esa misma pantalla se puede regenerar; regenerarla no borra datos.
#   Queda así (sin las llaves):
#     postgresql://postgres.wyqmzhliurwyxuyxznpb:{CONTRASEÑA}@aws-0-us-east-2.pooler.supabase.com:5432/postgres
#
# Alternativa local — el Postgres del docker-compose de infra/docker/.
# El puerto es 5433 a propósito: 5432 se deja libre por si hay otro Postgres.
DATABASE_URL=postgres://morphiqpos:morphiqpos_local@localhost:5433/morphiqpos

# Consumidas por docker-compose. Cámbialas en una instalación real de cliente.
POSTGRES_USER=morphiqpos
POSTGRES_PASSWORD=morphiqpos_local
POSTGRES_DB=morphiqpos
POSTGRES_PORT=5433

# --- Almacenamiento de archivos ----------------------------------------------
# Local: MinIO del compose. En un despliegue gestionado se cambia el endpoint y
# nada más: la implementación vive detrás de ServicioArchivos (04-ARQUITECTURA §5).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=morphiqpos
STORAGE_ACCESS_KEY=morphiqpos
STORAGE_SECRET_KEY=morphiqpos_local
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# --- Sesión y credenciales ---------------------------------------------------
# GENERA LOS TUYOS. No uses estos valores ni en local:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# SESSION_SECRET  firma las cookies de sesión del servidor.
# PIN_PEPPER      pimienta del hash Argon2id de los PIN de empleado (P0-01).
#                 Rotarla invalida todos los PIN: exige reenrolar a todo el mundo.
SESSION_SECRET=cambia-esto-por-32-bytes-aleatorios
PIN_PEPPER=cambia-esto-tambien-por-32-bytes-aleatorios

# --- Aplicación --------------------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development
TZ=America/Mexico_City

# A qué negocio sirve ESTE despliegue, por su `slug` en `organizaciones`.
#
# La pantalla de acceso enseña la lista de empleados ANTES de que exista sesión,
# así que el servidor tiene que saber de qué negocio son sin preguntárselo al
# navegador: quien elige la organización nunca es el cliente (R16). Antes eso lo
# decía la terminal enrolada con un código de seis dígitos; ese código no lo
# pidió nadie y se retiró.
#
# OPCIONAL: si la base tiene UNA sola organización activa —un negocio con su
# propio dominio— se resuelve sola. Con varias y sin esto, la pantalla de acceso
# falla diciendo que falta esta variable, en vez de elegir un negocio por su
# cuenta y enseñar la plantilla de otro.
# ORGANIZACION=demo-ferreteria-la-broca
