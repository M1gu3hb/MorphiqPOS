# --- Dependencias ---
node_modules
.pnpm-store

# --- Build ---
dist
build
.next
out
.turbo
*.tsbuildinfo

# --- Pruebas ---
coverage
.nyc_output
playwright-report
test-results
blob-report
.playwright

# --- Entorno · R31: cero secretos en el repositorio ---
# La re-inclusion de .env.example NO va aqui: mas abajo hay un `.env*` que
# volveria a capturarlo, y en git manda el ULTIMO patron que empareja.
.env
.env.*

# --- Sistema operativo y editores ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recomendado.json

# --- Registros ---
*.log
npm-debug.log*
pnpm-debug.log*

# --- Datos locales de Docker ---
infra/docker/datos

# --- historico/ es evidencia, no codigo (04-ARQUITECTURA §1, R30, R34) ---
# No se compila, no se lintea, no se importa y no se versiona:
# contiene el ZIP del POS de restaurante y el clon de la tiendita,
# que describen sistemas hoy en produccion con clientes reales.
historico/*
!historico/README.md

# Generado por next build.
apps/web/next-env.d.ts

# Scratch del CLI de Supabase. No es configuracion del proyecto.
supabase/.temp/

# Vinculo local con el proyecto de Vercel. Lleva ids de organizacion y de
# proyecto, y el token OIDC que descarga la CLI: no va al repositorio publico.
.vercel/
.vercel
.env*

# --- La unica excepcion, y va AL FINAL a proposito -------------------------
# `.env.example` no trae secretos: trae los NOMBRES de las variables, y
# `verify:entorno` lo exige. Tiene que quedar despues del `.env*` de arriba
# porque git aplica el ultimo patron que empareja: puesta antes, la negacion
# no hacia nada y el archivo sobrevivia solo por estar ya rastreado. El dia
# que alguien lo sacara del indice, desapareceria sin que nadie lo notara.
!.env.example
